{
  "$schema": "./schema.json",
  "id": "northbank_customer_platform",
  "name": "NorthBank Customer Platform",
  "description": "NorthBank's Customer Platform Team: onboarding, KYC and consent, and the Customer domain.",
  "version": "1.0.0",
  "odsVersion": "3.0.0",
  "primaryColor": "#1d4ed8",
  "domains": {
    "customer": {
      "name": "Customer",
      "description": "Knowing who the customer is, what they agreed to, and serving them",
      "subdomains": {
        "onboarding_&_kyc": {
          "name": "Onboarding & KYC",
          "type": "supporting",
          "description": "Verifying identity before anything else. Regulated and necessary"
        },
        "consent": {
          "name": "Consent",
          "type": "supporting",
          "description": "Purpose, scope, expiry, withdrawal. A first-class thing since the 2022 fine"
        },
        "branch_&_contact_centre": {
          "name": "Branch & Contact Centre",
          "type": "supporting",
          "description": "Face-to-face and phone service"
        }
      }
    }
  },
  "boundedcontexts": {
    "customer_&_kyc": {
      "name": "Customer & KYC",
      "description": "Verified customers, their documents and their consents",
      "subdomains": [
        {
          "$ref": "#/domains/customer/subdomains/onboarding_&_kyc"
        },
        {
          "$ref": "#/domains/customer/subdomains/consent"
        }
      ],
      "team": {
        "$ref": "#/teams/customer_platform_team"
      },
      "aggregates": {
        "customer": {
          "name": "Customer",
          "description": "A verified person and the documents that verify them",
          "provides": {
            "customer_verified": {
              "name": "CustomerVerified",
              "description": "KYC passed; accounts may be opened",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/customer_&_kyc/schemas/customer_verified"
              }
            },
            "verify_customer": {
              "name": "VerifyCustomer",
              "description": "Mark KYC as passed once documents and screening are clear",
              "type": "operation",
              "internal": true,
              "raises": [
                {
                  "$ref": "#/boundedcontexts/customer_&_kyc/aggregates/customer/provides/customer_verified"
                }
              ]
            },
            "hold_onboarding": {
              "name": "HoldOnboarding",
              "description": "Stop everything until Financial Crime clears the match",
              "type": "operation",
              "internal": true
            }
          },
          "consumes": [],
          "entities": {
            "customer": {
              "name": "Customer",
              "description": "Someone the bank has verified",
              "root": true,
              "attributes": {
                "customer_id": {
                  "name": "customerId",
                  "type": "string",
                  "identity": true
                },
                "legal_name": {
                  "name": "legalName",
                  "type": "string"
                },
                "date_of_birth": {
                  "name": "dateOfBirth",
                  "type": "DateOfBirth",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/customer_&_kyc/valueobjects/date_of_birth"
                  }
                },
                "kyc_status": {
                  "name": "kycStatus",
                  "type": "KycStatus",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/customer_&_kyc/valueobjects/kyc_status"
                  }
                },
                "address": {
                  "name": "address",
                  "type": "Address",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/customer_&_kyc/valueobjects/address"
                  }
                }
              },
              "relations": [
                {
                  "target": {
                    "$ref": "#/boundedcontexts/customer_&_kyc/aggregates/customer/entities/identity_document"
                  },
                  "relation": "includes",
                  "label": "verified-by",
                  "cardinality": "*"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/customer_&_kyc/valueobjects/date_of_birth"
                  },
                  "relation": "uses",
                  "label": "born-on",
                  "cardinality": "1"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/customer_&_kyc/valueobjects/address"
                  },
                  "relation": "uses",
                  "label": "lives-at",
                  "cardinality": "1"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/customer_&_kyc/valueobjects/kyc_status"
                  },
                  "relation": "uses",
                  "label": "has-status",
                  "cardinality": "1"
                }
              ]
            },
            "identity_document": {
              "name": "IdentityDocument",
              "description": "A passport or licence checked during onboarding; kept for audit",
              "root": false,
              "attributes": {
                "document_type": {
                  "name": "documentType",
                  "type": "'passport' | 'driving-licence'"
                },
                "number": {
                  "name": "number",
                  "type": "string",
                  "identity": true
                },
                "expires_on": {
                  "name": "expiresOn",
                  "type": "date"
                }
              },
              "relations": []
            }
          },
          "invariants": {
            "adult_only": {
              "name": "AdultOnly",
              "description": "A customer is eighteen or over on the day onboarding starts, computed from the date of birth; no exceptions",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/customer_&_kyc/aggregates/customer/entities/customer"
                }
              ]
            },
            "verified_needs_document": {
              "name": "VerifiedNeedsDocument",
              "description": "A verified customer has at least one identity document on file",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/customer_&_kyc/valueobjects/kyc_status"
                },
                {
                  "$ref": "#/boundedcontexts/customer_&_kyc/aggregates/customer/entities/identity_document"
                }
              ]
            },
            "document_not_expired": {
              "name": "DocumentNotExpired",
              "description": "A document past its expiry does not count towards verification",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/customer_&_kyc/aggregates/customer/entities/identity_document/attributes/expires_on"
                }
              ]
            }
          }
        },
        "consent": {
          "name": "Consent",
          "description": "One permission with a purpose, a scope and a lifetime; its own aggregate because it changes independently of the customer record",
          "provides": {
            "consent_given": {
              "name": "ConsentGiven",
              "description": "A permission now exists",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/customer_&_kyc/schemas/consent_changed"
              }
            },
            "consent_withdrawn": {
              "name": "ConsentWithdrawn",
              "description": "A permission ended; published the same second",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/customer_&_kyc/schemas/consent_changed"
              }
            }
          },
          "consumes": [],
          "entities": {
            "consent": {
              "name": "Consent",
              "description": "A permission given, and possibly withdrawn, by a customer",
              "root": true,
              "attributes": {
                "consent_id": {
                  "name": "consentId",
                  "type": "string",
                  "identity": true
                },
                "customer_id": {
                  "name": "customerId",
                  "type": "string"
                },
                "given_at": {
                  "name": "givenAt",
                  "type": "date-time"
                },
                "withdrawn_at": {
                  "name": "withdrawnAt",
                  "type": "date-time"
                },
                "expires_at": {
                  "name": "expiresAt",
                  "type": "date-time"
                },
                "purpose": {
                  "name": "purpose",
                  "type": "ConsentPurpose",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/customer_&_kyc/valueobjects/consent_purpose"
                  }
                },
                "scope": {
                  "name": "scope",
                  "type": "ConsentScope",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/customer_&_kyc/valueobjects/consent_scope"
                  }
                }
              },
              "relations": [
                {
                  "target": {
                    "$ref": "#/boundedcontexts/customer_&_kyc/valueobjects/consent_purpose"
                  },
                  "relation": "uses",
                  "label": "for",
                  "cardinality": "1"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/customer_&_kyc/valueobjects/consent_scope"
                  },
                  "relation": "uses",
                  "label": "covers",
                  "cardinality": "1"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/customer_&_kyc/aggregates/customer/entities/customer"
                  },
                  "relation": "references",
                  "label": "given-by",
                  "cardinality": "1"
                }
              ]
            }
          },
          "invariants": {
            "withdrawn_is_final": {
              "name": "WithdrawnIsFinal",
              "description": "A withdrawn consent is never reinstated; a new consent is given instead",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/customer_&_kyc/aggregates/consent/entities/consent/attributes/withdrawn_at"
                }
              ]
            },
            "purpose_required": {
              "name": "PurposeRequired",
              "description": "A consent without a purpose is not a consent",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/customer_&_kyc/valueobjects/consent_purpose"
                }
              ]
            },
            "open_banking_consent_expires": {
              "name": "OpenBankingConsentExpires",
              "description": "An open banking consent expires within twelve months of being given",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/customer_&_kyc/aggregates/consent/entities/consent/attributes/expires_at"
                },
                {
                  "$ref": "#/boundedcontexts/customer_&_kyc/valueobjects/consent_purpose"
                }
              ]
            }
          }
        }
      },
      "invariants": {},
      "services": {
        "onboarding_app": {
          "name": "OnboardingApp",
          "description": "The onboarding journey and the customer read API",
          "type": "application",
          "provides": {
            "give_consent": {
              "name": "GiveConsent",
              "description": "Record a permission",
              "pattern": "open-host-service",
              "type": "operation",
              "schema": {
                "$ref": "#/boundedcontexts/customer_&_kyc/schemas/consent_changed"
              },
              "raises": [
                {
                  "$ref": "#/boundedcontexts/customer_&_kyc/aggregates/consent/provides/consent_given"
                }
              ]
            },
            "withdraw_consent": {
              "name": "WithdrawConsent",
              "description": "End a permission, finally",
              "pattern": "open-host-service",
              "type": "operation",
              "schema": {
                "$ref": "#/boundedcontexts/customer_&_kyc/schemas/consent_changed"
              },
              "raises": [
                {
                  "$ref": "#/boundedcontexts/customer_&_kyc/aggregates/consent/provides/consent_withdrawn"
                }
              ]
            },
            "start_onboarding": {
              "name": "StartOnboarding",
              "description": "Begin with name, date of birth, address and a document",
              "pattern": "open-host-service",
              "type": "operation"
            },
            "get_customer": {
              "name": "GetCustomer",
              "description": "Asked with a CustomerRef, answers with the customer's verified details",
              "pattern": "open-host-service",
              "type": "operation",
              "schema": {
                "$ref": "#/boundedcontexts/customer_&_kyc/schemas/customer_ref"
              },
              "returns": {
                "$ref": "#/boundedcontexts/customer_&_kyc/schemas/customer_details"
              }
            },
            "screen_customer": {
              "name": "ScreenCustomer",
              "description": "Screen the prospective customer against the sanctions lists, through the ACL",
              "type": "operation",
              "internal": true
            }
          },
          "consumes": [
            {
              "consumable": {
                "$ref": "financial_crime.json#/boundedcontexts/sanctions_screening/services/screening_app/provides/screen_party"
              },
              "pattern": "anti-corruption-layer",
              "by": [
                {
                  "$ref": "#/boundedcontexts/customer_&_kyc/services/onboarding_app/provides/screen_customer"
                }
              ]
            },
            {
              "consumable": {
                "$ref": "financial_crime.json#/boundedcontexts/sanctions_screening/aggregates/screening_result/provides/party_matched"
              },
              "pattern": "anti-corruption-layer"
            }
          ]
        }
      },
      "policies": {},
      "processes": {
        "customer_onboarding": {
          "name": "Customer onboarding",
          "description": "From a prospective customer's details to a verified one. Everyone is screened before anything else, and the process then waits on the engine's verdict: a match holds the onboarding until Financial Crime clears it by hand, which is why there is no timeout; a clean screening lets KYC verify the customer. Correlation is by customerId, which the screening event carries back; the instance ends when KYC passes and accounts may be opened",
          "starts": [
            {
              "$ref": "#/boundedcontexts/customer_&_kyc/services/onboarding_app/provides/start_onboarding"
            }
          ],
          "on": [
            {
              "$ref": "financial_crime.json#/boundedcontexts/sanctions_screening/aggregates/screening_result/provides/party_matched"
            }
          ],
          "then": [
            {
              "$ref": "#/boundedcontexts/customer_&_kyc/services/onboarding_app/provides/screen_customer"
            },
            {
              "$ref": "#/boundedcontexts/customer_&_kyc/aggregates/customer/provides/hold_onboarding"
            },
            {
              "$ref": "#/boundedcontexts/customer_&_kyc/aggregates/customer/provides/verify_customer"
            }
          ],
          "ends": [
            {
              "$ref": "#/boundedcontexts/customer_&_kyc/aggregates/customer/provides/customer_verified"
            }
          ]
        }
      },
      "glossary": {
        "customer": {
          "name": "Customer",
          "definition": "A verified person. Branches say member; payments say party",
          "aliases": [
            "Member",
            "Party"
          ],
          "embodiedBy": {
            "$ref": "#/boundedcontexts/customer_&_kyc/aggregates/customer"
          }
        },
        "kyc": {
          "name": "KYC",
          "definition": "Know your customer: the verification that must pass before any account opens",
          "embodiedBy": {
            "$ref": "#/boundedcontexts/customer_&_kyc/valueobjects/kyc_status"
          }
        },
        "consent": {
          "name": "Consent",
          "definition": "A permission with a purpose, a scope and a lifetime; withdrawal is final",
          "embodiedBy": {
            "$ref": "#/boundedcontexts/customer_&_kyc/aggregates/consent"
          }
        }
      },
      "valueobjects": {
        "date_of_birth": {
          "name": "DateOfBirth",
          "description": "A date; the source of the age rule",
          "attributes": {
            "value": {
              "name": "value",
              "type": "date"
            }
          },
          "relations": [],
          "invariants": {}
        },
        "address": {
          "name": "Address",
          "description": "Residential address, verified against the electoral roll",
          "attributes": {
            "lines": {
              "name": "lines",
              "type": "string[]"
            },
            "postcode": {
              "name": "postcode",
              "type": "string"
            }
          },
          "relations": [],
          "invariants": {}
        },
        "kyc_status": {
          "name": "KycStatus",
          "description": "pending, held (sanctions match), verified",
          "attributes": {
            "value": {
              "name": "value",
              "type": "'pending' | 'held' | 'verified'"
            }
          },
          "relations": [],
          "invariants": {}
        },
        "consent_purpose": {
          "name": "ConsentPurpose",
          "description": "marketing, data-sharing or open-banking; the purpose decides the rules",
          "attributes": {
            "value": {
              "name": "value",
              "type": "'marketing' | 'data-sharing' | 'open-banking'"
            }
          },
          "relations": [],
          "invariants": {}
        },
        "consent_scope": {
          "name": "ConsentScope",
          "description": "Channels and data categories the permission covers",
          "attributes": {
            "channels": {
              "name": "channels",
              "type": "string[]"
            },
            "data_categories": {
              "name": "dataCategories",
              "type": "string[]"
            }
          },
          "relations": [],
          "invariants": {}
        }
      },
      "schemas": {
        "customer_ref": {
          "name": "CustomerRef",
          "attributes": {
            "customer_id": {
              "name": "customerId",
              "type": "string",
              "identity": true
            }
          }
        },
        "customer_verified": {
          "name": "CustomerVerified",
          "attributes": {
            "customer_id": {
              "name": "customerId",
              "type": "string",
              "identity": true
            },
            "verified_at": {
              "name": "verifiedAt",
              "type": "date-time"
            }
          }
        },
        "customer_details": {
          "name": "CustomerDetails",
          "description": "The verified details GetCustomer answers with",
          "attributes": {
            "customer_id": {
              "name": "customerId",
              "type": "string",
              "identity": true
            },
            "date_of_birth": {
              "name": "dateOfBirth",
              "type": "DateOfBirth",
              "valueobject": {
                "$ref": "#/boundedcontexts/customer_&_kyc/valueobjects/date_of_birth"
              }
            },
            "address": {
              "name": "address",
              "type": "Address",
              "valueobject": {
                "$ref": "#/boundedcontexts/customer_&_kyc/valueobjects/address"
              }
            },
            "kyc_status": {
              "name": "kycStatus",
              "type": "KycStatus",
              "valueobject": {
                "$ref": "#/boundedcontexts/customer_&_kyc/valueobjects/kyc_status"
              }
            }
          }
        },
        "consent_changed": {
          "name": "ConsentChanged",
          "description": "Used by both consent events; the contact centre acts on it the same day",
          "attributes": {
            "consent_id": {
              "name": "consentId",
              "type": "string",
              "identity": true
            },
            "customer_id": {
              "name": "customerId",
              "type": "string",
              "identifies": {
                "$ref": "#/boundedcontexts/customer_&_kyc/aggregates/customer/entities/customer"
              }
            },
            "purpose": {
              "name": "purpose",
              "type": "ConsentPurpose",
              "valueobject": {
                "$ref": "#/boundedcontexts/customer_&_kyc/valueobjects/consent_purpose"
              }
            }
          }
        }
      }
    }
  },
  "relationships": [
    {
      "type": "upstream-downstream",
      "upstream": {
        "$ref": "financial_crime.json#/boundedcontexts/sanctions_screening"
      },
      "downstream": {
        "$ref": "#/boundedcontexts/customer_&_kyc"
      },
      "upstreamRoles": [
        "open-host-service",
        "published-language"
      ],
      "downstreamRoles": [
        "anti-corruption-layer"
      ]
    }
  ],
  "teams": {
    "customer_platform_team": {
      "name": "Customer Platform Team",
      "description": "Onboarding, KYC, consent"
    }
  }
}