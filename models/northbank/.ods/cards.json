{
  "$schema": "./schema.json",
  "id": "northbank_cards",
  "name": "NorthBank Cards",
  "description": "NorthBank's Cards Team: issuing, authorisation and the integration with CardCo, the outsourced card processor.",
  "version": "1.0.0",
  "odsVersion": "3.0.0",
  "primaryColor": "#1d4ed8",
  "domains": {},
  "boundedcontexts": {
    "cards": {
      "name": "Cards",
      "description": "Issued cards and their authorisations, via CardCo",
      "subdomains": [
        {
          "$ref": "core_banking.json#/domains/banking_products/subdomains/cards"
        }
      ],
      "team": {
        "$ref": "#/teams/cards_team"
      },
      "aggregates": {
        "card": {
          "name": "Card",
          "description": "An issued card and its authorisations; the checks on a card need both",
          "provides": {
            "card_authorised": {
              "name": "CardAuthorised",
              "description": "A merchant's request was approved; Accounts holds the amount and Fraud monitors",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/cards/schemas/card_authorised"
              }
            },
            "card_blocked": {
              "name": "CardBlocked",
              "description": "The card authorises nothing until unblocked",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/cards/schemas/card_event"
              }
            },
            "issue_card": {
              "name": "IssueCard",
              "description": "Issue a card on an account",
              "type": "operation",
              "internal": true
            }
          },
          "consumes": [],
          "entities": {
            "card": {
              "name": "Card",
              "description": "One physical or virtual card on one account",
              "root": true,
              "attributes": {
                "card_id": {
                  "name": "cardId",
                  "type": "string",
                  "identity": true
                },
                "account_id": {
                  "name": "accountId",
                  "type": "string",
                  "identifies": {
                    "$ref": "accounts.json#/boundedcontexts/accounts/aggregates/account/entities/account"
                  }
                },
                "pan": {
                  "name": "pan",
                  "type": "PAN",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/cards/valueobjects/pan"
                  }
                },
                "expiry": {
                  "name": "expiry",
                  "type": "Expiry",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/cards/valueobjects/expiry"
                  }
                },
                "status": {
                  "name": "status",
                  "type": "CardStatus",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/cards/valueobjects/card_status"
                  }
                }
              },
              "relations": [
                {
                  "target": {
                    "$ref": "#/boundedcontexts/cards/aggregates/card/entities/authorisation"
                  },
                  "relation": "includes",
                  "label": "authorised",
                  "cardinality": "*"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/cards/valueobjects/pan"
                  },
                  "relation": "uses",
                  "label": "numbered",
                  "cardinality": "1"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/cards/valueobjects/expiry"
                  },
                  "relation": "uses",
                  "label": "expires",
                  "cardinality": "1"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/cards/valueobjects/card_status"
                  },
                  "relation": "uses",
                  "label": "has-status",
                  "cardinality": "1"
                }
              ]
            },
            "authorisation": {
              "name": "Authorisation",
              "description": "A merchant's approved request to take an amount; an entity because it is later captured or expires",
              "root": false,
              "attributes": {
                "authorisation_id": {
                  "name": "authorisationId",
                  "type": "string",
                  "identity": true
                },
                "card_co_ref": {
                  "name": "cardCoRef",
                  "type": "string",
                  "identifies": {
                    "$ref": "#/boundedcontexts/card_co"
                  }
                },
                "merchant": {
                  "name": "merchant",
                  "type": "string"
                },
                "amount": {
                  "name": "amount",
                  "type": "Money",
                  "valueobject": {
                    "$ref": "core_banking.json#/boundedcontexts/ledger/valueobjects/money"
                  }
                },
                "at": {
                  "name": "at",
                  "type": "date-time"
                }
              },
              "relations": []
            }
          },
          "invariants": {
            "no_auth_on_blocked_card": {
              "name": "NoAuthOnBlockedCard",
              "description": "A blocked card authorises nothing",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/cards/valueobjects/card_status"
                },
                {
                  "$ref": "#/boundedcontexts/cards/aggregates/card/entities/authorisation"
                }
              ]
            },
            "expired_card_no_auth": {
              "name": "ExpiredCardNoAuth",
              "description": "Past expiry, nothing authorises",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/cards/valueobjects/expiry"
                },
                {
                  "$ref": "#/boundedcontexts/cards/aggregates/card/entities/authorisation"
                }
              ]
            },
            "auth_within_available_balance": {
              "name": "AuthWithinAvailableBalance",
              "description": "Every authorisation AuthoriseCard approves carries an amount within the available balance AccountServicing reported at that moment. The balance moves next door the second after, so the promise is about the moment the answer was given, not about the balance since (card 94)",
              "postcondition": true,
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/cards/schemas/card_authorisation_approved/attributes/amount"
                },
                {
                  "$ref": "#/boundedcontexts/cards/services/cards_app/provides/authorise_card"
                }
              ]
            }
          }
        }
      },
      "invariants": {},
      "services": {
        "cards_app": {
          "name": "CardsApp",
          "description": "Cards' application service: the boundary CardCo authorises against and channels block cards through",
          "type": "application",
          "provides": {
            "authorise_card": {
              "name": "AuthoriseCard",
              "description": "Approve or decline a merchant's request from CardCo, in the message CardCo sends; the caller waits, and is answered with the authorisation or with the rule that stopped it",
              "pattern": "open-host-service",
              "type": "operation",
              "schema": {
                "$ref": "#/boundedcontexts/card_co/schemas/card_co_authorisation_message"
              },
              "returns": {
                "$ref": "#/boundedcontexts/cards/schemas/card_authorisation_approved"
              },
              "rejects": [
                {
                  "$ref": "#/boundedcontexts/cards/schemas/card_authorisation_declined"
                }
              ],
              "raises": [
                {
                  "$ref": "#/boundedcontexts/cards/aggregates/card/provides/card_authorised"
                }
              ]
            },
            "block_card": {
              "name": "BlockCard",
              "description": "Block a card; issued by fraud or by a customer through a channel",
              "pattern": "open-host-service",
              "type": "operation",
              "schema": {
                "$ref": "#/boundedcontexts/cards/schemas/card_event"
              },
              "raises": [
                {
                  "$ref": "#/boundedcontexts/cards/aggregates/card/provides/card_blocked"
                }
              ]
            }
          },
          "consumes": [
            {
              "consumable": {
                "$ref": "accounts.json#/boundedcontexts/accounts/services/account_servicing/provides/get_available_balance"
              },
              "pattern": "anti-corruption-layer",
              "by": [
                {
                  "$ref": "#/boundedcontexts/cards/services/cards_app/provides/authorise_card"
                }
              ]
            },
            {
              "consumable": {
                "$ref": "financial_crime.json#/boundedcontexts/fraud/services/fraud_app/provides/score_transaction"
              },
              "pattern": "anti-corruption-layer",
              "by": [
                {
                  "$ref": "#/boundedcontexts/cards/services/cards_app/provides/authorise_card"
                }
              ]
            },
            {
              "consumable": {
                "$ref": "financial_crime.json#/boundedcontexts/fraud/services/transaction_scorer/provides/transaction_flagged"
              },
              "pattern": "anti-corruption-layer"
            }
          ]
        }
      },
      "policies": {
        "block_on_flagged_card_transaction": {
          "name": "Block on flagged card transaction",
          "description": "A flag on a card-channel transaction blocks the card",
          "on": [
            {
              "$ref": "financial_crime.json#/boundedcontexts/fraud/services/transaction_scorer/provides/transaction_flagged"
            }
          ],
          "then": [
            {
              "$ref": "#/boundedcontexts/cards/services/cards_app/provides/block_card"
            }
          ]
        }
      },
      "processes": {},
      "glossary": {
        "pan": {
          "name": "PAN",
          "definition": "The card number; held as a token and the last four digits",
          "embodiedBy": {
            "$ref": "#/boundedcontexts/cards/valueobjects/pan"
          }
        },
        "authorisation": {
          "name": "Authorisation",
          "definition": "A merchant's approved request to take an amount. Not a mandate",
          "embodiedBy": {
            "$ref": "#/boundedcontexts/cards/aggregates/card/entities/authorisation"
          }
        },
        "payment": {
          "name": "Payment",
          "definition": "A card transaction. The Payments Hub's payment is an instruction to a payee",
          "embodiedBy": {
            "$ref": "#/boundedcontexts/cards/aggregates/card/entities/authorisation"
          }
        }
      },
      "valueobjects": {
        "pan": {
          "name": "PAN",
          "description": "The card number, held as a token plus last four; the full number passes Luhn",
          "attributes": {
            "token": {
              "name": "token",
              "type": "string"
            },
            "last_four": {
              "name": "lastFour",
              "type": "string"
            }
          },
          "relations": [],
          "invariants": {
            "pan_luhn_valid": {
              "name": "PanLuhnValid",
              "description": "A PAN value is only ever created from a full number that passed the Luhn check; the token and last four are never re-checked because they cannot be",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/cards/valueobjects/pan"
                }
              ]
            }
          }
        },
        "expiry": {
          "name": "Expiry",
          "description": "Month and year after which nothing authorises",
          "attributes": {
            "month": {
              "name": "month",
              "type": "int 1..12"
            },
            "year": {
              "name": "year",
              "type": "int"
            }
          },
          "relations": [],
          "invariants": {}
        },
        "card_status": {
          "name": "CardStatus",
          "description": "active, blocked, expired",
          "attributes": {
            "value": {
              "name": "value",
              "type": "'active' | 'blocked' | 'expired'"
            }
          },
          "relations": [],
          "invariants": {}
        }
      },
      "schemas": {
        "card_event": {
          "name": "CardEvent",
          "description": "Card and account; shared by the card events",
          "attributes": {
            "card_id": {
              "name": "cardId",
              "type": "string",
              "identity": true
            },
            "account_id": {
              "name": "accountId",
              "type": "string",
              "identifies": {
                "$ref": "accounts.json#/boundedcontexts/accounts/aggregates/account/entities/account"
              }
            }
          }
        },
        "card_authorised": {
          "name": "CardAuthorised",
          "description": "Card, account and the authorised amount; Accounts needs the amount to place the hold",
          "attributes": {
            "card_id": {
              "name": "cardId",
              "type": "string",
              "identity": true
            },
            "account_id": {
              "name": "accountId",
              "type": "string",
              "identifies": {
                "$ref": "accounts.json#/boundedcontexts/accounts/aggregates/account/entities/account"
              }
            },
            "authorisation_id": {
              "name": "authorisationId",
              "type": "string",
              "identifies": {
                "$ref": "#/boundedcontexts/cards/aggregates/card/entities/authorisation"
              }
            },
            "amount": {
              "name": "amount",
              "type": "Money",
              "valueobject": {
                "$ref": "core_banking.json#/boundedcontexts/ledger/valueobjects/money"
              }
            }
          }
        },
        "card_authorisation_approved": {
          "name": "CardAuthorisationApproved",
          "description": "What CardCo is answered with when the request is approved: the authorisation and the amount now held",
          "attributes": {
            "authorisation_id": {
              "name": "authorisationId",
              "type": "string",
              "identity": true,
              "identifies": {
                "$ref": "#/boundedcontexts/cards/aggregates/card/entities/authorisation"
              }
            },
            "amount": {
              "name": "amount",
              "type": "Money",
              "valueobject": {
                "$ref": "core_banking.json#/boundedcontexts/ledger/valueobjects/money"
              }
            }
          }
        },
        "card_authorisation_declined": {
          "name": "CardAuthorisationDeclined",
          "description": "Why the request was declined: the card is blocked, the card has expired, or the available balance does not cover it. No authorisation exists, so there is no card event to raise",
          "attributes": {
            "card_id": {
              "name": "cardId",
              "type": "string",
              "identifies": {
                "$ref": "#/boundedcontexts/cards/aggregates/card/entities/card"
              }
            },
            "reason": {
              "name": "reason",
              "type": "'blocked' | 'expired' | 'insufficient-funds'"
            }
          }
        }
      }
    },
    "card_co": {
      "name": "CardCo",
      "description": "The outsourced card processor: it sends the authorisation requests and takes the answers, in its own format",
      "subdomains": [],
      "external": true,
      "aggregates": {},
      "invariants": {},
      "services": {
        "card_co_authorisation_feed": {
          "name": "CardCo Authorisation Feed",
          "description": "The processor's authorisation side, and all the bank can see of it: it takes the merchant's request and calls the issuer",
          "type": "application",
          "provides": {},
          "consumes": [
            {
              "consumable": {
                "$ref": "#/boundedcontexts/cards/services/cards_app/provides/authorise_card"
              }
            }
          ]
        }
      },
      "policies": {},
      "processes": {},
      "glossary": {},
      "valueobjects": {},
      "schemas": {
        "card_co_authorisation_message": {
          "name": "CardCoAuthorisationMessage",
          "description": "CardCo's wire format, as it arrives",
          "attributes": {
            "pan_token": {
              "name": "panToken",
              "type": "string"
            },
            "merchant": {
              "name": "merchant",
              "type": "string"
            },
            "amount_minor_units": {
              "name": "amountMinorUnits",
              "type": "int64"
            },
            "currency": {
              "name": "currency",
              "type": "ISO 4217 code"
            }
          }
        }
      }
    }
  },
  "relationships": [
    {
      "type": "upstream-downstream",
      "upstream": {
        "$ref": "#/boundedcontexts/card_co"
      },
      "downstream": {
        "$ref": "#/boundedcontexts/cards"
      },
      "upstreamRoles": [
        "published-language"
      ],
      "downstreamRoles": [
        "anti-corruption-layer"
      ],
      "description": "CardCo's format is CardCo's: it dictates the message every authorisation arrives in, and Cards translates it at its own boundary rather than adopting it. The bank provides the operation and offers it as an open host; who provides is not who is upstream"
    },
    {
      "type": "customer-supplier",
      "upstream": {
        "$ref": "financial_crime.json#/boundedcontexts/fraud"
      },
      "downstream": {
        "$ref": "#/boundedcontexts/cards"
      },
      "upstreamRoles": [
        "open-host-service",
        "published-language"
      ],
      "downstreamRoles": [
        "anti-corruption-layer"
      ]
    },
    {
      "type": "upstream-downstream",
      "upstream": {
        "$ref": "accounts.json#/boundedcontexts/accounts"
      },
      "downstream": {
        "$ref": "#/boundedcontexts/cards"
      },
      "upstreamRoles": [
        "open-host-service"
      ],
      "downstreamRoles": [
        "anti-corruption-layer"
      ],
      "description": "The balance check at authorisation time"
    },
    {
      "type": "upstream-downstream",
      "upstream": {
        "$ref": "core_banking.json#/boundedcontexts/ledger"
      },
      "downstream": {
        "$ref": "#/boundedcontexts/cards"
      },
      "upstreamRoles": [
        "published-language"
      ],
      "downstreamRoles": [
        "conformist"
      ],
      "description": "Money only, from @northbank/money, taken as Accounts and Ledger release it. Assumed: the Cards lead did not mention the library"
    }
  ],
  "teams": {
    "cards_team": {
      "name": "Cards Team",
      "description": "Issuing and the CardCo integration"
    }
  }
}