{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
        "AggregateSchema": {
            "additionalProperties": false,
            "description": "Represents an aggregate in the Open Domain Specification (ODS).",
            "properties": {
                "consumes": {
                    "items": {
                        "$ref": "#/definitions/ConsumptionSchema"
                    },
                    "type": "array"
                },
                "description": {
                    "type": "string"
                },
                "entities": {
                    "additionalProperties": {
                        "$ref": "#/definitions/EntitySchema"
                    },
                    "type": "object"
                },
                "invariants": {
                    "additionalProperties": {
                        "$ref": "#/definitions/InvariantSchema"
                    },
                    "type": "object"
                },
                "name": {
                    "type": "string"
                },
                "provides": {
                    "additionalProperties": {
                        "$ref": "#/definitions/ConsumableSchema"
                    },
                    "type": "object"
                },
                "valueobjects": {
                    "additionalProperties": {
                        "$ref": "#/definitions/ValueObjectSchema"
                    },
                    "type": "object"
                }
            },
            "required": [
                "consumes",
                "description",
                "entities",
                "invariants",
                "name",
                "provides",
                "valueobjects"
            ],
            "title": "Aggregate",
            "type": "object"
        },
        "AttributeSchema": {
            "additionalProperties": false,
            "description": "A named, typed property of an entity, value object or schema.",
            "properties": {
                "description": {
                    "type": "string"
                },
                "identity": {
                    "description": "True when this attribute is (part of) the identity of an entity.",
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "type": {
                    "description": "Free-form type name, e.g. `string`, `Money`, `Date`.",
                    "type": "string"
                },
                "valueobject": {
                    "additionalProperties": false,
                    "description": "The value object that models this attribute's type, when there is one.",
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                }
            },
            "required": [
                "name",
                "type"
            ],
            "title": "Attribute",
            "type": "object"
        },
        "BoundedContextSchema": {
            "additionalProperties": false,
            "description": "Represents a bounded context in the Open Domain Specification (ODS).",
            "properties": {
                "aggregates": {
                    "additionalProperties": {
                        "$ref": "#/definitions/AggregateSchema"
                    },
                    "type": "object"
                },
                "bigBallOfMud": {
                    "description": "Marks a context whose model is not coherent (typically legacy) so that\nneighbours know to protect themselves from it.",
                    "type": "boolean"
                },
                "description": {
                    "type": "string"
                },
                "glossary": {
                    "additionalProperties": {
                        "$ref": "#/definitions/GlossaryTermSchema"
                    },
                    "type": "object"
                },
                "name": {
                    "type": "string"
                },
                "policies": {
                    "additionalProperties": {
                        "$ref": "#/definitions/PolicySchema"
                    },
                    "type": "object"
                },
                "schemas": {
                    "additionalProperties": {
                        "$ref": "#/definitions/DataSchemaSchema"
                    },
                    "description": "Payload shapes this context publishes or accepts, referenced by its consumables.",
                    "type": "object"
                },
                "services": {
                    "additionalProperties": {
                        "$ref": "#/definitions/ServiceSchema"
                    },
                    "type": "object"
                },
                "subdomains": {
                    "description": "The subdomains this context serves; a context may serve several.",
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "$ref": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "$ref"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                "team": {
                    "additionalProperties": false,
                    "description": "The team that owns this context.",
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                }
            },
            "required": [
                "aggregates",
                "description",
                "glossary",
                "name",
                "policies",
                "schemas",
                "services",
                "subdomains"
            ],
            "title": "BoundedContext",
            "type": "object"
        },
        "Comment": {
            "additionalProperties": false,
            "description": "A short grounded statement about the real system behind a strategic intent, optionally backed by one link.",
            "properties": {
                "link": {
                    "$ref": "#/definitions/CommentLink"
                },
                "text": {
                    "type": "string"
                }
            },
            "required": [
                "text"
            ],
            "title": "Comment",
            "type": "object"
        },
        "CommentLink": {
            "additionalProperties": false,
            "description": "Where the evidence for a comment lives: the code, the contract, the decision record, the runbook or the dashboard.",
            "properties": {
                "kind": {
                    "$ref": "#/definitions/CommentLinkKind"
                },
                "label": {
                    "description": "What to show instead of the raw URL.",
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            },
            "required": [
                "kind",
                "url"
            ],
            "title": "CommentLink",
            "type": "object"
        },
        "CommentLinkKind": {
            "description": "What a comment's link points at.",
            "enum": [
                "adr",
                "code",
                "contract",
                "dashboard",
                "runbook"
            ],
            "type": "string"
        },
        "ConsumableSchema": {
            "additionalProperties": false,
            "description": "Represents a consumable in the Open Domain Specification (ODS).",
            "properties": {
                "comments": {
                    "description": "Grounded statements about the real system behind this consumable.",
                    "items": {
                        "$ref": "#/definitions/Comment"
                    },
                    "type": "array"
                },
                "description": {
                    "type": "string"
                },
                "disposition": {
                    "$ref": "#/definitions/Disposition",
                    "description": "What the architecture thinks of this consumable. Absent means `by-design`."
                },
                "internal": {
                    "description": "True when the consumable stays inside its context: an event only local\npolicies react to, or an operation only local callers issue. Internal\nconsumables may not be consumed from another context.",
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "pattern": {
                    "$ref": "#/definitions/UpstreamRole",
                    "description": "The upstream role this consumable is offered under. Absent on internal consumables."
                },
                "raises": {
                    "description": "For operations: the event consumables this operation may raise.",
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "$ref": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "$ref"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                "schema": {
                    "additionalProperties": false,
                    "description": "The payload shape, one of the context's schemas.",
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                },
                "type": {
                    "$ref": "#/definitions/ConsumableType"
                }
            },
            "required": [
                "description",
                "name",
                "type"
            ],
            "title": "Consumable",
            "type": "object"
        },
        "ConsumableType": {
            "enum": [
                "event",
                "operation"
            ],
            "type": "string"
        },
        "ConsumptionSchema": {
            "additionalProperties": false,
            "description": "Represents a consumption in the Open Domain Specification (ODS).",
            "properties": {
                "comments": {
                    "description": "Grounded statements about the real system behind this consumption.",
                    "items": {
                        "$ref": "#/definitions/Comment"
                    },
                    "type": "array"
                },
                "consumable": {
                    "additionalProperties": false,
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                },
                "disposition": {
                    "$ref": "#/definitions/Disposition",
                    "description": "What the architecture thinks of this consumption. Absent means `by-design`."
                },
                "pattern": {
                    "$ref": "#/definitions/DownstreamRole",
                    "description": "The downstream role the consumer adopts for this consumable."
                }
            },
            "required": [
                "consumable"
            ],
            "title": "Consumption",
            "type": "object"
        },
        "ContextRelationshipSchema": {
            "anyOf": [
                {
                    "$ref": "#/definitions/DirectedContextRelationshipSchema"
                },
                {
                    "$ref": "#/definitions/SymmetricContextRelationshipSchema"
                }
            ],
            "description": "A strategic relationship between two bounded contexts.",
            "title": "ContextRelationship"
        },
        "DataSchemaSchema": {
            "additionalProperties": false,
            "description": "A named payload shape owned by a bounded context, shared by the consumables that carry it.",
            "properties": {
                "attributes": {
                    "additionalProperties": {
                        "$ref": "#/definitions/AttributeSchema"
                    },
                    "type": "object"
                },
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            },
            "required": [
                "attributes",
                "name"
            ],
            "title": "DataSchema",
            "type": "object"
        },
        "DirectedContextRelationshipSchema": {
            "additionalProperties": false,
            "description": "An upstream/downstream relationship between two bounded contexts.",
            "properties": {
                "comments": {
                    "description": "Grounded statements about the real system behind this relationship.",
                    "items": {
                        "$ref": "#/definitions/Comment"
                    },
                    "type": "array"
                },
                "description": {
                    "type": "string"
                },
                "disposition": {
                    "$ref": "#/definitions/Disposition",
                    "description": "What the architecture thinks of this relationship. Absent means `by-design`."
                },
                "downstream": {
                    "additionalProperties": false,
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                },
                "downstreamRoles": {
                    "items": {
                        "$ref": "#/definitions/DownstreamRole"
                    },
                    "type": "array"
                },
                "type": {
                    "$ref": "#/definitions/DirectedRelationshipType"
                },
                "upstream": {
                    "additionalProperties": false,
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                },
                "upstreamRoles": {
                    "items": {
                        "$ref": "#/definitions/UpstreamRole"
                    },
                    "type": "array"
                }
            },
            "required": [
                "downstream",
                "downstreamRoles",
                "type",
                "upstream",
                "upstreamRoles"
            ],
            "title": "DirectedContextRelationship",
            "type": "object"
        },
        "DirectedRelationshipType": {
            "description": "Relationships with a clear upstream and downstream side. `customer-supplier`\nis an upstream/downstream relationship where the downstream team has a say\nin the upstream's planning.",
            "enum": [
                "customer-supplier",
                "upstream-downstream"
            ],
            "type": "string"
        },
        "Disposition": {
            "description": "What the architecture thinks of a strategic intent: `by-design` is how it\nshould be, `tolerated` a known compromise nobody plans to change, and\n`refactor` something that should be removed or replaced. An absent\ndisposition means `by-design`.",
            "enum": [
                "by-design",
                "refactor",
                "tolerated"
            ],
            "type": "string"
        },
        "DomainSchema": {
            "additionalProperties": false,
            "description": "Represents a domain in the Open Domain Specification (ODS).",
            "properties": {
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "subdomains": {
                    "additionalProperties": {
                        "$ref": "#/definitions/SubdomainSchema"
                    },
                    "type": "object"
                }
            },
            "required": [
                "description",
                "name",
                "subdomains"
            ],
            "title": "Domain",
            "type": "object"
        },
        "DownstreamRole": {
            "description": "How a downstream context protects itself from what it consumes.",
            "enum": [
                "anti-corruption-layer",
                "conformist"
            ],
            "type": "string"
        },
        "EntityRelationSchema": {
            "additionalProperties": false,
            "properties": {
                "cardinality": {
                    "$ref": "#/definitions/RelationCardinality"
                },
                "label": {
                    "type": "string"
                },
                "relation": {
                    "$ref": "#/definitions/EntityRelationType"
                },
                "target": {
                    "additionalProperties": false,
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                }
            },
            "required": [
                "relation",
                "target"
            ],
            "type": "object"
        },
        "EntityRelationType": {
            "enum": [
                "includes",
                "references",
                "uses"
            ],
            "type": "string"
        },
        "EntitySchema": {
            "additionalProperties": false,
            "description": "Represents an entity in the Open Domain Specification (ODS).",
            "properties": {
                "attributes": {
                    "additionalProperties": {
                        "$ref": "#/definitions/AttributeSchema"
                    },
                    "type": "object"
                },
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "relations": {
                    "items": {
                        "$ref": "#/definitions/EntityRelationSchema"
                    },
                    "type": "array"
                },
                "root": {
                    "type": "boolean"
                }
            },
            "required": [
                "attributes",
                "description",
                "name",
                "relations"
            ],
            "title": "Entity",
            "type": "object"
        },
        "GlossaryTermSchema": {
            "additionalProperties": false,
            "description": "A term of the ubiquitous language of a bounded context.",
            "properties": {
                "aliases": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "definition": {
                    "type": "string"
                },
                "embodiedBy": {
                    "additionalProperties": false,
                    "description": "The model element that embodies this term, when there is one.",
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                },
                "name": {
                    "type": "string"
                }
            },
            "required": [
                "definition",
                "name"
            ],
            "title": "GlossaryTerm",
            "type": "object"
        },
        "InvariantSchema": {
            "additionalProperties": false,
            "description": "Represents an invariant in the Open Domain Specification (ODS).",
            "properties": {
                "constrains": {
                    "description": "The entities, value objects or attributes this invariant constrains.",
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "$ref": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "$ref"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            },
            "required": [
                "constrains",
                "description",
                "name"
            ],
            "title": "Invariant",
            "type": "object"
        },
        "PolicySchema": {
            "additionalProperties": false,
            "description": "A reaction: when these events happen, issue these commands.",
            "properties": {
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "on": {
                    "description": "The event consumables that trigger this policy.",
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "$ref": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "$ref"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                "then": {
                    "description": "The operation consumables this policy issues.",
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "$ref": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "$ref"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                }
            },
            "required": [
                "description",
                "name",
                "on",
                "then"
            ],
            "title": "Policy",
            "type": "object"
        },
        "RelationCardinality": {
            "description": "How many targets one source relates to, in UML multiplicity notation.",
            "enum": [
                "*",
                "0..1",
                "1",
                "1..*"
            ],
            "type": "string"
        },
        "ServiceSchema": {
            "additionalProperties": false,
            "description": "Represents a service in the Open Domain Specification (ODS).",
            "properties": {
                "consumes": {
                    "items": {
                        "$ref": "#/definitions/ConsumptionSchema"
                    },
                    "type": "array"
                },
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "provides": {
                    "additionalProperties": {
                        "$ref": "#/definitions/ConsumableSchema"
                    },
                    "type": "object"
                },
                "type": {
                    "$ref": "#/definitions/ServiceType"
                }
            },
            "required": [
                "consumes",
                "description",
                "name",
                "provides",
                "type"
            ],
            "title": "Service",
            "type": "object"
        },
        "ServiceType": {
            "description": "Application services orchestrate use cases and expose them to the outside;\ndomain services hold domain logic that belongs to no single aggregate.\nInfrastructure is an implementation concern and is not modelled.",
            "enum": [
                "application",
                "domain"
            ],
            "type": "string"
        },
        "SubdomainSchema": {
            "additionalProperties": false,
            "description": "Represents a subdomain in the Open Domain Specification (ODS).",
            "properties": {
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "type": {
                    "$ref": "#/definitions/SubdomainType"
                }
            },
            "required": [
                "description",
                "name",
                "type"
            ],
            "title": "Subdomain",
            "type": "object"
        },
        "SubdomainType": {
            "description": "Strategic classification of a subdomain: the part of the problem space\nthe business competes on (core), needs but does not differentiate on\n(supporting), or can buy off the shelf (generic).",
            "enum": [
                "core",
                "generic",
                "supporting"
            ],
            "type": "string"
        },
        "SymmetricContextRelationshipSchema": {
            "additionalProperties": false,
            "description": "A relationship between two bounded contexts with no upstream or downstream side.",
            "properties": {
                "comments": {
                    "description": "Grounded statements about the real system behind this relationship.",
                    "items": {
                        "$ref": "#/definitions/Comment"
                    },
                    "type": "array"
                },
                "description": {
                    "type": "string"
                },
                "disposition": {
                    "$ref": "#/definitions/Disposition",
                    "description": "What the architecture thinks of this relationship. Absent means `by-design`."
                },
                "participants": {
                    "items": [
                        {
                            "additionalProperties": false,
                            "properties": {
                                "$ref": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "$ref"
                            ],
                            "type": "object"
                        },
                        {
                            "additionalProperties": false,
                            "properties": {
                                "$ref": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "$ref"
                            ],
                            "type": "object"
                        }
                    ],
                    "maxItems": 2,
                    "minItems": 2,
                    "type": "array"
                },
                "type": {
                    "$ref": "#/definitions/SymmetricRelationshipType"
                }
            },
            "required": [
                "participants",
                "type"
            ],
            "title": "SymmetricContextRelationship",
            "type": "object"
        },
        "SymmetricRelationshipType": {
            "description": "Relationships without a direction: teams share a kernel, work as partners,\nor deliberately do not integrate at all.",
            "enum": [
                "partnership",
                "separate-ways",
                "shared-kernel"
            ],
            "type": "string"
        },
        "TeamSchema": {
            "additionalProperties": false,
            "description": "A team that owns one or more bounded contexts.",
            "properties": {
                "description": {
                    "type": "string"
                },
                "homepage": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            },
            "required": [
                "name"
            ],
            "title": "Team",
            "type": "object"
        },
        "UpstreamRole": {
            "description": "How an upstream context exposes what it provides.",
            "enum": [
                "open-host-service",
                "published-language"
            ],
            "type": "string"
        },
        "ValueObjectSchema": {
            "additionalProperties": false,
            "description": "Represents a value object in the Open Domain Specification (ODS).",
            "properties": {
                "attributes": {
                    "additionalProperties": {
                        "$ref": "#/definitions/AttributeSchema"
                    },
                    "type": "object"
                },
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "relations": {
                    "items": {
                        "$ref": "#/definitions/EntityRelationSchema"
                    },
                    "type": "array"
                }
            },
            "required": [
                "attributes",
                "description",
                "name",
                "relations"
            ],
            "title": "ValueObject",
            "type": "object"
        }
    },
    "description": "Represents a workspace in the Open Domain Specification (ODS).",
    "properties": {
        "$schema": {
            "description": "Location of the JSON schema this document conforms to, usually the schema.json beside it. Ignored by the loader.",
            "type": "string"
        },
        "boundedcontexts": {
            "additionalProperties": {
                "$ref": "#/definitions/BoundedContextSchema"
            },
            "type": "object"
        },
        "description": {
            "type": "string"
        },
        "domains": {
            "additionalProperties": {
                "$ref": "#/definitions/DomainSchema"
            },
            "type": "object"
        },
        "homepage": {
            "type": "string"
        },
        "id": {
            "type": "string"
        },
        "logoUrl": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "odsVersion": {
            "pattern": "^[0-9]*\\.[0-9]*\\.[0-9]*$",
            "type": "string"
        },
        "primaryColor": {
            "type": "string"
        },
        "relationships": {
            "items": {
                "$ref": "#/definitions/ContextRelationshipSchema"
            },
            "type": "array"
        },
        "teams": {
            "additionalProperties": {
                "$ref": "#/definitions/TeamSchema"
            },
            "type": "object"
        },
        "version": {
            "type": "string"
        }
    },
    "required": [
        "boundedcontexts",
        "description",
        "domains",
        "id",
        "name",
        "odsVersion",
        "relationships",
        "teams",
        "version"
    ],
    "title": "Workspace",
    "type": "object"
}

