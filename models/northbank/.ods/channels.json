{
  "$schema": "./schema.json",
  "id": "northbank_channels",
  "name": "NorthBank Channels",
  "description": "NorthBank's Channels Team: branch and contact centre tooling.",
  "version": "1.0.0",
  "odsVersion": "3.0.0",
  "primaryColor": "#1d4ed8",
  "domains": {},
  "boundedcontexts": {
    "branch_&_contact_centre": {
      "name": "Branch & Contact Centre",
      "description": "Service requests raised in branches and on the phone",
      "subdomains": [
        {
          "$ref": "customer_platform.json#/domains/customer/subdomains/branch_&_contact_centre"
        }
      ],
      "team": {
        "$ref": "#/teams/channels_team"
      },
      "aggregates": {
        "service_request": {
          "name": "ServiceRequest",
          "description": "A customer asking for something through a channel, with notes",
          "provides": {
            "service_request_raised": {
              "name": "ServiceRequestRaised",
              "description": "A customer asked for something",
              "type": "event",
              "internal": true
            },
            "suppress_marketing": {
              "name": "SuppressMarketing",
              "description": "Stop every outbound contact for the customer the same day",
              "type": "operation",
              "internal": true
            }
          },
          "consumes": [],
          "entities": {
            "service_request": {
              "name": "ServiceRequest",
              "description": "One ask, one outcome",
              "root": true,
              "attributes": {
                "request_id": {
                  "name": "requestId",
                  "type": "string",
                  "identity": true
                },
                "customer_id": {
                  "name": "customerId",
                  "type": "string",
                  "identifies": {
                    "$ref": "customer_platform.json#/boundedcontexts/customer_&_kyc/aggregates/customer/entities/customer"
                  }
                },
                "authenticated": {
                  "name": "authenticated",
                  "type": "boolean"
                },
                "channel": {
                  "name": "channel",
                  "type": "Channel",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/branch_&_contact_centre/valueobjects/channel"
                  }
                },
                "status": {
                  "name": "status",
                  "type": "RequestStatus",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/branch_&_contact_centre/valueobjects/request_status"
                  }
                }
              },
              "relations": [
                {
                  "target": {
                    "$ref": "#/boundedcontexts/branch_&_contact_centre/aggregates/service_request/entities/note"
                  },
                  "relation": "includes",
                  "label": "annotated-by",
                  "cardinality": "*"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/branch_&_contact_centre/valueobjects/channel"
                  },
                  "relation": "uses",
                  "label": "through",
                  "cardinality": "1"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/branch_&_contact_centre/valueobjects/request_status"
                  },
                  "relation": "uses",
                  "label": "has-status",
                  "cardinality": "1"
                }
              ]
            },
            "note": {
              "name": "Note",
              "description": "What an agent recorded; added, never edited",
              "root": false,
              "attributes": {
                "note_id": {
                  "name": "noteId",
                  "type": "string",
                  "identity": true
                },
                "author": {
                  "name": "author",
                  "type": "string"
                },
                "text": {
                  "name": "text",
                  "type": "string"
                },
                "at": {
                  "name": "at",
                  "type": "date-time"
                }
              },
              "relations": []
            }
          },
          "invariants": {
            "authenticated_before_action": {
              "name": "AuthenticatedBeforeAction",
              "description": "Nothing is done on a request until the customer is authenticated",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/branch_&_contact_centre/aggregates/service_request/entities/service_request"
                }
              ]
            },
            "note_immutable": {
              "name": "NoteImmutable",
              "description": "Notes are added, never edited or deleted",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/branch_&_contact_centre/aggregates/service_request/entities/note"
                }
              ]
            }
          }
        }
      },
      "invariants": {},
      "services": {
        "channels_app": {
          "name": "ChannelsApp",
          "description": "The branch and contact centre application service: the boundary agents raise requests through",
          "type": "application",
          "provides": {
            "raise_request": {
              "name": "RaiseRequest",
              "description": "Open a request in a branch or on the phone",
              "pattern": "open-host-service",
              "type": "operation",
              "raises": [
                {
                  "$ref": "#/boundedcontexts/branch_&_contact_centre/aggregates/service_request/provides/service_request_raised"
                }
              ]
            }
          },
          "consumes": [
            {
              "consumable": {
                "$ref": "customer_platform.json#/boundedcontexts/customer_&_kyc/services/onboarding_app/provides/get_customer"
              },
              "pattern": "conformist",
              "by": [
                {
                  "$ref": "#/boundedcontexts/branch_&_contact_centre/services/channels_app/provides/raise_request"
                }
              ]
            },
            {
              "consumable": {
                "$ref": "accounts.json#/boundedcontexts/accounts/services/account_servicing/provides/get_available_balance"
              },
              "pattern": "conformist",
              "by": [
                {
                  "$ref": "#/boundedcontexts/branch_&_contact_centre/services/channels_app/provides/raise_request"
                }
              ]
            },
            {
              "consumable": {
                "$ref": "cards.json#/boundedcontexts/cards/services/cards_app/provides/block_card"
              },
              "pattern": "conformist",
              "by": [
                {
                  "$ref": "#/boundedcontexts/branch_&_contact_centre/services/channels_app/provides/raise_request"
                }
              ]
            },
            {
              "consumable": {
                "$ref": "customer_platform.json#/boundedcontexts/customer_&_kyc/aggregates/consent/provides/consent_withdrawn"
              },
              "pattern": "conformist"
            },
            {
              "consumable": {
                "$ref": "credit_risk.json#/boundedcontexts/credit_decisioning/services/decisioning_app/provides/decide"
              },
              "pattern": "anti-corruption-layer",
              "by": [
                {
                  "$ref": "#/boundedcontexts/branch_&_contact_centre/services/channels_app/provides/raise_request"
                }
              ]
            },
            {
              "consumable": {
                "$ref": "digital_platform.json#/boundedcontexts/identity_&_access/services/identity_app/provides/authenticate_customer"
              },
              "pattern": "conformist",
              "by": [
                {
                  "$ref": "#/boundedcontexts/branch_&_contact_centre/services/channels_app/provides/raise_request"
                }
              ]
            }
          ]
        }
      },
      "policies": {
        "suppress_marketing_on_withdrawal": {
          "name": "Suppress marketing on withdrawal",
          "description": "A withdrawn marketing consent stops outbound contact the same day; the fix for the fine",
          "on": [
            {
              "$ref": "customer_platform.json#/boundedcontexts/customer_&_kyc/aggregates/consent/provides/consent_withdrawn"
            }
          ],
          "then": [
            {
              "$ref": "#/boundedcontexts/branch_&_contact_centre/aggregates/service_request/provides/suppress_marketing"
            }
          ]
        }
      },
      "processes": {},
      "glossary": {
        "request": {
          "name": "Request",
          "definition": "One customer ask tracked to an outcome",
          "aliases": [
            "Ticket"
          ],
          "embodiedBy": {
            "$ref": "#/boundedcontexts/branch_&_contact_centre/aggregates/service_request"
          }
        },
        "member": {
          "name": "Member",
          "definition": "What branch staff call a customer, from the mutual days. The same record as Customer & KYC's Customer, read through GetCustomer",
          "aliases": [
            "Customer"
          ]
        },
        "balance": {
          "name": "Balance",
          "definition": "What the screen shows: the available balance as returned by GetAvailableBalance at the moment of the call, never recomputed here",
          "embodiedBy": {
            "$ref": "#/boundedcontexts/branch_&_contact_centre/aggregates/service_request"
          }
        },
        "returned_payment": {
          "name": "Returned payment",
          "definition": "A payment sent back by the payee's bank. Not a regulatory return",
          "embodiedBy": {
            "$ref": "#/boundedcontexts/branch_&_contact_centre/aggregates/service_request/entities/service_request"
          }
        }
      },
      "valueobjects": {
        "channel": {
          "name": "Channel",
          "description": "branch, phone or chat",
          "attributes": {
            "value": {
              "name": "value",
              "type": "'branch' | 'phone' | 'chat'"
            }
          },
          "relations": [],
          "invariants": {}
        },
        "request_status": {
          "name": "RequestStatus",
          "description": "open, resolved",
          "attributes": {
            "value": {
              "name": "value",
              "type": "'open' | 'resolved'"
            }
          },
          "relations": [],
          "invariants": {}
        }
      },
      "schemas": {}
    }
  },
  "relationships": [
    {
      "type": "upstream-downstream",
      "upstream": {
        "$ref": "customer_platform.json#/boundedcontexts/customer_&_kyc"
      },
      "downstream": {
        "$ref": "#/boundedcontexts/branch_&_contact_centre"
      },
      "upstreamRoles": [
        "open-host-service",
        "published-language"
      ],
      "downstreamRoles": [
        "conformist"
      ]
    },
    {
      "type": "upstream-downstream",
      "upstream": {
        "$ref": "accounts.json#/boundedcontexts/accounts"
      },
      "downstream": {
        "$ref": "#/boundedcontexts/branch_&_contact_centre"
      },
      "upstreamRoles": [
        "open-host-service"
      ],
      "downstreamRoles": [
        "conformist"
      ]
    },
    {
      "type": "upstream-downstream",
      "upstream": {
        "$ref": "cards.json#/boundedcontexts/cards"
      },
      "downstream": {
        "$ref": "#/boundedcontexts/branch_&_contact_centre"
      },
      "upstreamRoles": [
        "open-host-service"
      ],
      "downstreamRoles": [
        "conformist"
      ]
    },
    {
      "type": "upstream-downstream",
      "upstream": {
        "$ref": "digital_platform.json#/boundedcontexts/identity_&_access"
      },
      "downstream": {
        "$ref": "#/boundedcontexts/branch_&_contact_centre"
      },
      "upstreamRoles": [
        "open-host-service"
      ],
      "downstreamRoles": [
        "conformist"
      ]
    },
    {
      "type": "separate-ways",
      "participants": [
        {
          "$ref": "#/boundedcontexts/branch_&_contact_centre"
        },
        {
          "$ref": "credit_risk.json#/boundedcontexts/credit_decisioning"
        }
      ],
      "description": "No integration by policy; the quick-quote consumption above contradicts this and is under investigation",
      "comments": [
        {
          "text": "The map says separate ways but Channels calls the quick-quote endpoint directly; one of the two has to go.",
          "link": {
            "kind": "code",
            "url": "https://github.com/example/northbank/blob/main/channels/quote/QuickQuoteClient.ts",
            "label": "channels/quote/QuickQuoteClient.ts"
          }
        },
        {
          "text": "Conduct policy is explicit that front-line staff may not influence a credit decision.",
          "link": {
            "kind": "adr",
            "url": "https://github.com/example/northbank/blob/main/docs/adr/021-conduct-separation.md",
            "label": "ADR-021 Conduct separation"
          }
        }
      ],
      "disposition": "refactor"
    }
  ],
  "teams": {
    "channels_team": {
      "name": "Channels Team",
      "description": "Branch and contact centre tooling"
    }
  }
}