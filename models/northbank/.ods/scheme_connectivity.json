{
  "$schema": "./schema.json",
  "id": "northbank_scheme_connectivity",
  "name": "NorthBank Scheme Connectivity",
  "description": "NorthBank's Scheme Connectivity Team: gateways to the payment schemes, and the scheme they submit to.",
  "version": "1.0.0",
  "odsVersion": "3.0.0",
  "primaryColor": "#1d4ed8",
  "domains": {},
  "boundedcontexts": {
    "scheme_gateway": {
      "name": "Scheme Gateway",
      "description": "ISO 20022 messages to and from the schemes",
      "subdomains": [
        {
          "$ref": "payments.json#/domains/money_movement/subdomains/scheme_connectivity"
        }
      ],
      "team": {
        "$ref": "#/teams/scheme_connectivity_team"
      },
      "aggregates": {
        "scheme_message": {
          "name": "SchemeMessage",
          "description": "One message to or from a scheme",
          "provides": {
            "scheme_accepted": {
              "name": "SchemeAccepted",
              "description": "The gateway's own settlement fact, translated from the scheme's SchemeSettlementConfirmed",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/scheme_gateway/schemas/scheme_accepted"
              }
            },
            "scheme_declined": {
              "name": "SchemeDeclined",
              "description": "The gateway's own refusal fact, translated from the scheme's SchemeRejected",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/scheme_gateway/schemas/scheme_declined"
              }
            },
            "record_scheme_acceptance": {
              "name": "RecordSchemeAcceptance",
              "description": "Match the scheme's confirmation to the message it answers and republish it as the gateway's own settlement fact",
              "type": "operation",
              "internal": true,
              "raises": [
                {
                  "$ref": "#/boundedcontexts/scheme_gateway/aggregates/scheme_message/provides/scheme_accepted"
                }
              ]
            },
            "record_scheme_rejection": {
              "name": "RecordSchemeRejection",
              "description": "Match the scheme's rejection to the message it answers and republish it as the gateway's own refusal fact",
              "type": "operation",
              "internal": true,
              "raises": [
                {
                  "$ref": "#/boundedcontexts/scheme_gateway/aggregates/scheme_message/provides/scheme_declined"
                }
              ]
            }
          },
          "consumes": [],
          "entities": {
            "scheme_message": {
              "name": "SchemeMessage",
              "description": "A submission or a response",
              "root": true,
              "attributes": {
                "message_id": {
                  "name": "messageId",
                  "type": "string",
                  "identity": true
                },
                "scheme_ref": {
                  "name": "schemeRef",
                  "type": "string"
                },
                "direction": {
                  "name": "direction",
                  "type": "'outbound' | 'inbound'"
                },
                "format": {
                  "name": "format",
                  "type": "SchemeFormat",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/scheme_gateway/valueobjects/scheme_format"
                  }
                }
              },
              "relations": [
                {
                  "target": {
                    "$ref": "#/boundedcontexts/scheme_gateway/valueobjects/scheme_format"
                  },
                  "relation": "uses",
                  "label": "formatted-as",
                  "cardinality": "1"
                }
              ]
            }
          },
          "invariants": {}
        }
      },
      "invariants": {},
      "services": {
        "scheme_gateway_app": {
          "name": "SchemeGatewayApp",
          "description": "The gateway's application service: the boundary the hub submits messages through",
          "type": "application",
          "provides": {
            "submit_to_scheme": {
              "name": "SubmitToScheme",
              "description": "Send a submission in the scheme's format; the scheme confirms or rejects later, on its own timings, as SchemeSettlementConfirmed or SchemeRejected",
              "pattern": "open-host-service",
              "type": "operation",
              "schema": {
                "$ref": "#/boundedcontexts/scheme_gateway/schemas/scheme_submission"
              }
            }
          },
          "consumes": [
            {
              "consumable": {
                "$ref": "#/boundedcontexts/payment_scheme/services/scheme_rail/provides/submit"
              },
              "pattern": "anti-corruption-layer",
              "by": [
                {
                  "$ref": "#/boundedcontexts/scheme_gateway/services/scheme_gateway_app/provides/submit_to_scheme"
                }
              ]
            },
            {
              "consumable": {
                "$ref": "#/boundedcontexts/payment_scheme/services/scheme_rail/provides/scheme_settlement_confirmed"
              },
              "pattern": "anti-corruption-layer",
              "by": [
                {
                  "$ref": "#/boundedcontexts/scheme_gateway/policies/translate_the_scheme's_answer"
                }
              ]
            },
            {
              "consumable": {
                "$ref": "#/boundedcontexts/payment_scheme/services/scheme_rail/provides/scheme_rejected"
              },
              "pattern": "anti-corruption-layer",
              "by": [
                {
                  "$ref": "#/boundedcontexts/scheme_gateway/policies/translate_the_scheme's_answer"
                }
              ]
            }
          ]
        }
      },
      "policies": {
        "translate_the_scheme's_answer": {
          "name": "Translate the scheme's answer",
          "description": "Either answer the scheme gives -- a settlement or a rejection -- is republished as the gateway's own fact, so the hub depends on the gateway's language and not the scheme's",
          "on": [
            {
              "$ref": "#/boundedcontexts/payment_scheme/services/scheme_rail/provides/scheme_settlement_confirmed"
            },
            {
              "$ref": "#/boundedcontexts/payment_scheme/services/scheme_rail/provides/scheme_rejected"
            }
          ],
          "then": [
            {
              "$ref": "#/boundedcontexts/scheme_gateway/aggregates/scheme_message/provides/record_scheme_acceptance"
            },
            {
              "$ref": "#/boundedcontexts/scheme_gateway/aggregates/scheme_message/provides/record_scheme_rejection"
            }
          ]
        }
      },
      "processes": {},
      "glossary": {},
      "valueobjects": {
        "scheme_format": {
          "name": "SchemeFormat",
          "description": "The ISO 20022 message type",
          "attributes": {
            "message_type": {
              "name": "messageType",
              "type": "'pacs.008' | 'pacs.002' | 'pain.001'"
            }
          },
          "relations": [],
          "invariants": {}
        }
      },
      "schemas": {
        "scheme_submission": {
          "name": "SchemeSubmission",
          "description": "The scheme's format, not the bank's",
          "attributes": {
            "instruction_id": {
              "name": "instructionId",
              "type": "string",
              "identity": true,
              "identifies": {
                "$ref": "payments.json#/boundedcontexts/payments_hub/aggregates/payment_instruction/entities/payment_instruction"
              }
            },
            "message_type": {
              "name": "messageType",
              "type": "SchemeFormat",
              "valueobject": {
                "$ref": "#/boundedcontexts/scheme_gateway/valueobjects/scheme_format"
              }
            }
          }
        },
        "scheme_accepted": {
          "name": "SchemeAccepted",
          "description": "The scheme settled: which instruction, and the scheme's own reference, in the gateway's own words",
          "attributes": {
            "instruction_id": {
              "name": "instructionId",
              "type": "string",
              "identity": true,
              "identifies": {
                "$ref": "payments.json#/boundedcontexts/payments_hub/aggregates/payment_instruction/entities/payment_instruction"
              }
            },
            "scheme_ref": {
              "name": "schemeRef",
              "type": "string"
            }
          }
        },
        "scheme_declined": {
          "name": "SchemeDeclined",
          "description": "The scheme refused: which instruction, and the scheme's status reason passed through untranslated, because you do not negotiate with a scheme",
          "attributes": {
            "instruction_id": {
              "name": "instructionId",
              "type": "string",
              "identity": true,
              "identifies": {
                "$ref": "payments.json#/boundedcontexts/payments_hub/aggregates/payment_instruction/entities/payment_instruction"
              }
            },
            "scheme_ref": {
              "name": "schemeRef",
              "type": "string"
            },
            "reason": {
              "name": "reason",
              "type": "string"
            }
          }
        }
      }
    },
    "payment_scheme": {
      "name": "Payment Scheme",
      "description": "The clearing scheme the bank submits to: it settles or refuses, in ISO 20022 and on its own timings. Not the bank's",
      "subdomains": [],
      "external": true,
      "aggregates": {},
      "invariants": {},
      "services": {
        "scheme_rail": {
          "name": "Scheme Rail",
          "description": "The scheme's inbound leg, and all the bank can see of it",
          "type": "application",
          "provides": {
            "scheme_settlement_confirmed": {
              "name": "SchemeSettlementConfirmed",
              "description": "The scheme settled the payment",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/payment_scheme/schemas/scheme_response"
              }
            },
            "scheme_rejected": {
              "name": "SchemeRejected",
              "description": "The scheme refused the message",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/payment_scheme/schemas/scheme_response"
              }
            },
            "submit": {
              "name": "Submit",
              "description": "Accept a submission in the scheme's format; the scheme confirms or rejects later, on its own timings, as SchemeSettlementConfirmed or SchemeRejected",
              "pattern": "open-host-service",
              "type": "operation",
              "schema": {
                "$ref": "#/boundedcontexts/payment_scheme/schemas/submission_message"
              },
              "raises": [
                {
                  "$ref": "#/boundedcontexts/payment_scheme/services/scheme_rail/provides/scheme_settlement_confirmed"
                },
                {
                  "$ref": "#/boundedcontexts/payment_scheme/services/scheme_rail/provides/scheme_rejected"
                }
              ]
            }
          },
          "consumes": []
        }
      },
      "policies": {},
      "processes": {},
      "glossary": {},
      "valueobjects": {},
      "schemas": {
        "scheme_response": {
          "name": "SchemeResponse",
          "description": "The scheme's status report, as it arrives on the wire",
          "attributes": {
            "original_instruction_id": {
              "name": "originalInstructionId",
              "type": "string"
            },
            "scheme_ref": {
              "name": "schemeRef",
              "type": "string"
            },
            "status_reason": {
              "name": "statusReason",
              "type": "string",
              "optional": true
            }
          }
        },
        "submission_message": {
          "name": "SubmissionMessage",
          "description": "The scheme's own wire format for an inbound submission, as it receives it",
          "attributes": {
            "instruction_id": {
              "name": "instructionId",
              "type": "string"
            },
            "message_type": {
              "name": "messageType",
              "type": "string"
            }
          }
        }
      }
    }
  },
  "relationships": [
    {
      "type": "upstream-downstream",
      "upstream": {
        "$ref": "#/boundedcontexts/payment_scheme"
      },
      "downstream": {
        "$ref": "#/boundedcontexts/scheme_gateway"
      },
      "upstreamRoles": [
        "published-language"
      ],
      "downstreamRoles": [
        "anti-corruption-layer"
      ],
      "description": "ISO 20022 as the scheme publishes it; the gateway takes the format as it is and translates at the edge"
    }
  ],
  "teams": {
    "scheme_connectivity_team": {
      "name": "Scheme Connectivity Team",
      "description": "Gateways to the schemes"
    }
  }
}