{
  "$schema": "./schema.json",
  "id": "northbank_lending",
  "name": "NorthBank Lending",
  "description": "NorthBank's Lending Team: origination and servicing of loans, and the Credit domain.",
  "version": "1.0.0",
  "odsVersion": "3.0.0",
  "primaryColor": "#1d4ed8",
  "domains": {
    "credit": {
      "name": "Credit",
      "description": "Lending the bank's money well",
      "subdomains": {
        "lending": {
          "name": "Lending",
          "type": "core",
          "description": "Origination and servicing. A below-market loss rate for fifteen years"
        },
        "credit_decisioning": {
          "name": "Credit Decisioning",
          "type": "core",
          "description": "The bank's own scorecard and affordability rules"
        }
      }
    }
  },
  "boundedcontexts": {
    "lending": {
      "name": "Lending",
      "description": "Applications, agreements, loans and schedules",
      "subdomains": [
        {
          "$ref": "#/domains/credit/subdomains/lending"
        }
      ],
      "team": {
        "$ref": "#/teams/lending_team"
      },
      "aggregates": {
        "loan_application": {
          "name": "LoanApplication",
          "description": "A customer asking for an amount over a term, and the decision on it",
          "provides": {
            "application_submitted": {
              "name": "ApplicationSubmitted",
              "description": "A customer asked for credit; decisioning runs",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/lending/schemas/application_submitted"
              }
            },
            "loan_approved": {
              "name": "LoanApproved",
              "description": "Decisioning said yes; an offer follows (out of scope)",
              "type": "event",
              "internal": true
            },
            "application_declined": {
              "name": "ApplicationDeclined",
              "description": "Decisioning said no, with reasons",
              "type": "event",
              "internal": true
            },
            "record_decision": {
              "name": "RecordDecision",
              "description": "Store decisioning's outcome and reasons",
              "type": "operation",
              "internal": true,
              "raises": [
                {
                  "$ref": "#/boundedcontexts/lending/aggregates/loan_application/provides/loan_approved"
                },
                {
                  "$ref": "#/boundedcontexts/lending/aggregates/loan_application/provides/application_declined"
                }
              ]
            }
          },
          "consumes": [],
          "entities": {
            "loan_application": {
              "name": "LoanApplication",
              "description": "One request for credit",
              "root": true,
              "attributes": {
                "application_id": {
                  "name": "applicationId",
                  "type": "string",
                  "identity": true
                },
                "customer_id": {
                  "name": "customerId",
                  "type": "string",
                  "identifies": {
                    "$ref": "customer_platform.json#/boundedcontexts/customer_&_kyc/aggregates/customer/entities/customer"
                  }
                },
                "requested": {
                  "name": "requested",
                  "type": "Money",
                  "valueobject": {
                    "$ref": "core_banking.json#/boundedcontexts/ledger/valueobjects/money"
                  }
                },
                "status": {
                  "name": "status",
                  "type": "'open' | 'decided' | 'withdrawn'"
                },
                "term": {
                  "name": "term",
                  "type": "Term",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/lending/valueobjects/term"
                  }
                },
                "decision": {
                  "name": "decision",
                  "type": "Decision",
                  "description": "Absent until Credit Decisioning has answered",
                  "optional": true,
                  "valueobject": {
                    "$ref": "#/boundedcontexts/lending/valueobjects/decision"
                  }
                }
              },
              "relations": [
                {
                  "target": {
                    "$ref": "#/boundedcontexts/lending/valueobjects/term"
                  },
                  "relation": "uses",
                  "label": "over",
                  "cardinality": "1"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/lending/valueobjects/decision"
                  },
                  "relation": "uses",
                  "label": "decided",
                  "cardinality": "0..1"
                }
              ]
            }
          },
          "invariants": {}
        },
        "loan": {
          "name": "Loan",
          "description": "A signed agreement, its schedule and its installments; the schedule is checked against the principal",
          "provides": {
            "loan_agreement_signed": {
              "name": "LoanAgreementSigned",
              "description": "The customer signed; disbursement may proceed",
              "type": "event",
              "internal": true
            },
            "loan_disbursed": {
              "name": "LoanDisbursed",
              "description": "The principal reached the account; the ledger posts and reporting counts it",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/lending/schemas/loan_event"
              }
            },
            "installment_missed": {
              "name": "InstallmentMissed",
              "description": "A due installment was not paid",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/lending/schemas/loan_event"
              }
            },
            "arrears_notice_issued": {
              "name": "ArrearsNoticeIssued",
              "description": "The customer was told the loan is in arrears",
              "type": "event",
              "internal": true
            },
            "disburse": {
              "name": "Disburse",
              "description": "Pay the principal into the customer's account",
              "type": "operation",
              "internal": true,
              "raises": [
                {
                  "$ref": "#/boundedcontexts/lending/aggregates/loan/provides/loan_disbursed"
                }
              ]
            },
            "mark_installment_missed": {
              "name": "MarkInstallmentMissed",
              "description": "Record a missed due date and move the loan into arrears",
              "type": "operation",
              "internal": true,
              "raises": [
                {
                  "$ref": "#/boundedcontexts/lending/aggregates/loan/provides/installment_missed"
                }
              ]
            },
            "issue_arrears_notice": {
              "name": "IssueArrearsNotice",
              "description": "Send the regulatory arrears notice",
              "type": "operation",
              "internal": true,
              "raises": [
                {
                  "$ref": "#/boundedcontexts/lending/aggregates/loan/provides/arrears_notice_issued"
                }
              ]
            }
          },
          "consumes": [],
          "entities": {
            "loan": {
              "name": "Loan",
              "description": "Money lent under a signed agreement",
              "root": true,
              "attributes": {
                "loan_id": {
                  "name": "loanId",
                  "type": "string",
                  "identity": true
                },
                "application_id": {
                  "name": "applicationId",
                  "type": "string"
                },
                "account_id": {
                  "name": "accountId",
                  "type": "string",
                  "description": "Identity of the Account the loan is disbursed to, in Accounts; only the id crosses the boundary",
                  "identifies": {
                    "$ref": "accounts.json#/boundedcontexts/accounts/aggregates/account/entities/account"
                  }
                },
                "principal": {
                  "name": "principal",
                  "type": "Money",
                  "valueobject": {
                    "$ref": "core_banking.json#/boundedcontexts/ledger/valueobjects/money"
                  }
                },
                "apr": {
                  "name": "apr",
                  "type": "InterestRate",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/lending/valueobjects/interest_rate"
                  }
                },
                "status": {
                  "name": "status",
                  "type": "LoanStatus",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/lending/valueobjects/loan_status"
                  }
                }
              },
              "relations": [
                {
                  "target": {
                    "$ref": "#/boundedcontexts/lending/aggregates/loan/entities/repayment_schedule"
                  },
                  "relation": "includes",
                  "label": "repaid-under",
                  "cardinality": "1"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/lending/valueobjects/interest_rate"
                  },
                  "relation": "uses",
                  "label": "charged-at",
                  "cardinality": "1"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/lending/valueobjects/loan_status"
                  },
                  "relation": "uses",
                  "label": "has-status",
                  "cardinality": "1"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/lending/aggregates/loan_application/entities/loan_application"
                  },
                  "relation": "references",
                  "label": "from-application",
                  "cardinality": "1"
                }
              ]
            },
            "repayment_schedule": {
              "name": "RepaymentSchedule",
              "description": "The plan of installments; an entity because it is re-cut on arrears",
              "root": false,
              "attributes": {
                "schedule_id": {
                  "name": "scheduleId",
                  "type": "string",
                  "identity": true
                }
              },
              "relations": [
                {
                  "target": {
                    "$ref": "#/boundedcontexts/lending/aggregates/loan/entities/installment"
                  },
                  "relation": "includes",
                  "label": "due",
                  "cardinality": "1..*"
                }
              ]
            },
            "installment": {
              "name": "Installment",
              "description": "One due payment",
              "root": false,
              "attributes": {
                "due_on": {
                  "name": "dueOn",
                  "type": "date",
                  "identity": true
                },
                "amount": {
                  "name": "amount",
                  "type": "Money",
                  "valueobject": {
                    "$ref": "core_banking.json#/boundedcontexts/ledger/valueobjects/money"
                  }
                },
                "paid": {
                  "name": "paid",
                  "type": "boolean"
                }
              },
              "relations": []
            }
          },
          "invariants": {
            "no_drawdown_before_signature": {
              "name": "NoDrawdownBeforeSignature",
              "description": "Nothing is disbursed before the agreement is signed",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/lending/valueobjects/loan_status"
                }
              ]
            },
            "apr_within_cap": {
              "name": "AprWithinCap",
              "description": "The APR never exceeds the regulatory cap",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/lending/valueobjects/interest_rate"
                }
              ]
            },
            "installments_sum_to_principal_plus_interest": {
              "name": "InstallmentsSumToPrincipalPlusInterest",
              "description": "The schedule's installments sum to principal plus interest",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/lending/aggregates/loan/entities/installment"
                },
                {
                  "$ref": "#/boundedcontexts/lending/aggregates/loan/entities/repayment_schedule"
                }
              ]
            },
            "arrears_after_missed_installment": {
              "name": "ArrearsAfterMissedInstallment",
              "description": "A missed installment puts the loan in arrears",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/lending/valueobjects/loan_status"
                },
                {
                  "$ref": "#/boundedcontexts/lending/aggregates/loan/entities/installment"
                }
              ]
            }
          }
        }
      },
      "invariants": {
        "one_open_application_per_customer": {
          "name": "OneOpenApplicationPerCustomer",
          "description": "A customer has at most one open application; SubmitApplication refuses a second while one is open",
          "constrains": [
            {
              "$ref": "#/boundedcontexts/lending/aggregates/loan_application/entities/loan_application"
            },
            {
              "$ref": "#/boundedcontexts/lending/services/lending_app/provides/submit_application"
            }
          ]
        }
      },
      "services": {
        "lending_app": {
          "name": "LendingApp",
          "description": "Lending's application service: the boundary applications arrive through, and the one that calls decisioning and the ledger",
          "type": "application",
          "provides": {
            "submit_application": {
              "name": "SubmitApplication",
              "description": "Ask for an amount over a term",
              "pattern": "open-host-service",
              "type": "operation",
              "schema": {
                "$ref": "#/boundedcontexts/lending/schemas/application_submitted"
              },
              "raises": [
                {
                  "$ref": "#/boundedcontexts/lending/aggregates/loan_application/provides/application_submitted"
                }
              ]
            },
            "sign_agreement": {
              "name": "SignAgreement",
              "description": "Record the signed agreement and create the loan",
              "pattern": "open-host-service",
              "type": "operation",
              "schema": {
                "$ref": "#/boundedcontexts/lending/schemas/loan_event"
              },
              "raises": [
                {
                  "$ref": "#/boundedcontexts/lending/aggregates/loan/provides/loan_agreement_signed"
                }
              ]
            },
            "post_disbursement": {
              "name": "PostDisbursement",
              "description": "Post the disbursement to the ledger, through the ACL over PostEntry",
              "type": "operation",
              "internal": true
            },
            "request_decision": {
              "name": "RequestDecision",
              "description": "Send a submitted application to Credit Decisioning",
              "type": "operation",
              "internal": true
            }
          },
          "consumes": [
            {
              "consumable": {
                "$ref": "core_banking.json#/boundedcontexts/ledger/services/ledger_app/provides/post_entry"
              },
              "pattern": "anti-corruption-layer",
              "by": [
                {
                  "$ref": "#/boundedcontexts/lending/services/lending_app/provides/post_disbursement"
                }
              ]
            },
            {
              "consumable": {
                "$ref": "customer_platform.json#/boundedcontexts/customer_&_kyc/services/onboarding_app/provides/get_customer"
              },
              "pattern": "anti-corruption-layer",
              "by": [
                {
                  "$ref": "#/boundedcontexts/lending/services/lending_app/provides/submit_application"
                }
              ]
            },
            {
              "consumable": {
                "$ref": "credit_risk.json#/boundedcontexts/credit_decisioning/services/decisioning_app/provides/decide"
              },
              "pattern": "conformist",
              "by": [
                {
                  "$ref": "#/boundedcontexts/lending/services/lending_app/provides/request_decision"
                }
              ]
            },
            {
              "consumable": {
                "$ref": "credit_risk.json#/boundedcontexts/credit_decisioning/aggregates/credit_decision/provides/decision_made"
              },
              "pattern": "conformist"
            }
          ]
        }
      },
      "policies": {
        "escalate_arrears": {
          "name": "Escalate arrears",
          "description": "A missed installment triggers the arrears notice",
          "on": [
            {
              "$ref": "#/boundedcontexts/lending/aggregates/loan/provides/installment_missed"
            }
          ],
          "then": [
            {
              "$ref": "#/boundedcontexts/lending/aggregates/loan/provides/arrears_notice_issued"
            }
          ]
        },
        "disburse_on_signature": {
          "name": "Disburse on signature",
          "description": "A signed agreement is disbursed",
          "on": [
            {
              "$ref": "#/boundedcontexts/lending/aggregates/loan/provides/loan_agreement_signed"
            }
          ],
          "then": [
            {
              "$ref": "#/boundedcontexts/lending/aggregates/loan/provides/disburse"
            }
          ]
        },
        "post_disbursement": {
          "name": "Post disbursement",
          "description": "Disbursement is a ledger entry: debit loan book, credit the account",
          "on": [
            {
              "$ref": "#/boundedcontexts/lending/aggregates/loan/provides/loan_disbursed"
            }
          ],
          "then": [
            {
              "$ref": "#/boundedcontexts/lending/services/lending_app/provides/post_disbursement"
            }
          ]
        },
        "decide_on_submission": {
          "name": "Decide on submission",
          "description": "Every submitted application is sent for a decision",
          "on": [
            {
              "$ref": "#/boundedcontexts/lending/aggregates/loan_application/provides/application_submitted"
            }
          ],
          "then": [
            {
              "$ref": "#/boundedcontexts/lending/services/lending_app/provides/request_decision"
            }
          ]
        },
        "record_decision": {
          "name": "Record decision",
          "description": "The outcome and reasons are stored on the application",
          "on": [
            {
              "$ref": "credit_risk.json#/boundedcontexts/credit_decisioning/aggregates/credit_decision/provides/decision_made"
            }
          ],
          "then": [
            {
              "$ref": "#/boundedcontexts/lending/aggregates/loan_application/provides/record_decision"
            }
          ]
        }
      },
      "processes": {},
      "glossary": {
        "loan": {
          "name": "Loan",
          "definition": "Money lent under a signed agreement, repaid by a schedule",
          "embodiedBy": {
            "$ref": "#/boundedcontexts/lending/aggregates/loan"
          }
        },
        "drawdown": {
          "name": "Drawdown",
          "definition": "Paying the principal to the customer. The ledger calls it a posting",
          "aliases": [
            "Disbursement"
          ],
          "embodiedBy": {
            "$ref": "#/boundedcontexts/lending/aggregates/loan/provides/disburse"
          }
        },
        "arrears": {
          "name": "Arrears",
          "definition": "At least one installment missed; the regulatory notice follows (IssueArrearsNotice). Notice intervals and forbearance are servicing detail left out (DISCOVERY section 8)",
          "embodiedBy": {
            "$ref": "#/boundedcontexts/lending/valueobjects/loan_status"
          }
        }
      },
      "valueobjects": {
        "term": {
          "name": "Term",
          "description": "Months to repay over",
          "attributes": {
            "months": {
              "name": "months",
              "type": "int"
            }
          },
          "relations": [],
          "invariants": {}
        },
        "decision": {
          "name": "Decision",
          "description": "approved or declined, with the reasons the customer is entitled to",
          "attributes": {
            "outcome": {
              "name": "outcome",
              "type": "'approved' | 'declined'"
            },
            "reasons": {
              "name": "reasons",
              "type": "string[]"
            }
          },
          "relations": [],
          "invariants": {}
        },
        "interest_rate": {
          "name": "InterestRate",
          "description": "Annual percentage rate, within the regulatory cap",
          "attributes": {
            "apr_percent": {
              "name": "aprPercent",
              "type": "decimal"
            }
          },
          "relations": [],
          "invariants": {}
        },
        "loan_status": {
          "name": "LoanStatus",
          "description": "approved, signed, disbursed, in-arrears, repaid",
          "attributes": {
            "value": {
              "name": "value",
              "type": "'approved' | 'signed' | 'disbursed' | 'in-arrears' | 'repaid'"
            }
          },
          "relations": [],
          "invariants": {}
        }
      },
      "schemas": {
        "application_submitted": {
          "name": "ApplicationSubmitted",
          "description": "What decisioning receives",
          "attributes": {
            "application_id": {
              "name": "applicationId",
              "type": "string",
              "identity": true
            },
            "customer_id": {
              "name": "customerId",
              "type": "string",
              "identifies": {
                "$ref": "customer_platform.json#/boundedcontexts/customer_&_kyc/aggregates/customer/entities/customer"
              }
            },
            "requested": {
              "name": "requested",
              "type": "Money",
              "valueobject": {
                "$ref": "core_banking.json#/boundedcontexts/ledger/valueobjects/money"
              }
            },
            "term": {
              "name": "term",
              "type": "Term",
              "valueobject": {
                "$ref": "#/boundedcontexts/lending/valueobjects/term"
              }
            }
          }
        },
        "loan_event": {
          "name": "LoanEvent",
          "description": "Loan, account and amount; shared by the loan events",
          "attributes": {
            "loan_id": {
              "name": "loanId",
              "type": "string",
              "identity": true
            },
            "account_id": {
              "name": "accountId",
              "type": "string",
              "identifies": {
                "$ref": "accounts.json#/boundedcontexts/accounts/aggregates/account/entities/account"
              }
            },
            "amount": {
              "name": "amount",
              "type": "Money",
              "valueobject": {
                "$ref": "core_banking.json#/boundedcontexts/ledger/valueobjects/money"
              }
            }
          }
        }
      }
    }
  },
  "relationships": [
    {
      "type": "upstream-downstream",
      "upstream": {
        "$ref": "customer_platform.json#/boundedcontexts/customer_&_kyc"
      },
      "downstream": {
        "$ref": "#/boundedcontexts/lending"
      },
      "upstreamRoles": [
        "open-host-service"
      ],
      "downstreamRoles": [
        "anti-corruption-layer"
      ]
    },
    {
      "type": "customer-supplier",
      "upstream": {
        "$ref": "core_banking.json#/boundedcontexts/ledger"
      },
      "downstream": {
        "$ref": "#/boundedcontexts/lending"
      },
      "upstreamRoles": [
        "open-host-service"
      ],
      "downstreamRoles": [
        "anti-corruption-layer"
      ]
    },
    {
      "type": "partnership",
      "participants": [
        {
          "$ref": "#/boundedcontexts/lending"
        },
        {
          "$ref": "credit_risk.json#/boundedcontexts/credit_decisioning"
        }
      ],
      "description": "Origination and decisioning release together; a scorecard change is an application-form change"
    }
  ],
  "teams": {
    "lending_team": {
      "name": "Lending Team",
      "description": "Origination and servicing; one planning board with Credit Risk"
    }
  }
}