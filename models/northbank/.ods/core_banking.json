{
  "$schema": "./schema.json",
  "id": "northbank_core_banking",
  "name": "NorthBank Core Banking",
  "description": "NorthBank's Core Banking Team: the double-entry ledger, the Sovereign legacy core and the Banking Products domain.",
  "version": "1.0.0",
  "odsVersion": "3.0.0",
  "primaryColor": "#1d4ed8",
  "domains": {
    "banking_products": {
      "name": "Banking Products",
      "description": "Accounts, the ledger beneath them, and cards",
      "subdomains": {
        "current_&_savings_accounts": {
          "name": "Current & Savings Accounts",
          "type": "core",
          "description": "The account is the relationship; where the Fair Treatment Rules bite"
        },
        "ledger": {
          "name": "Ledger",
          "type": "supporting",
          "description": "Double-entry postings. Must be perfect; not unique"
        },
        "cards": {
          "name": "Cards",
          "type": "generic",
          "description": "Issuing and authorisation. \"We would outsource it if the contract allowed\""
        }
      }
    }
  },
  "boundedcontexts": {
    "ledger": {
      "name": "Ledger",
      "description": "Balanced, immutable journal entries",
      "subdomains": [
        {
          "$ref": "#/domains/banking_products/subdomains/ledger"
        }
      ],
      "team": {
        "$ref": "#/teams/core_banking_team"
      },
      "aggregates": {
        "journal_entry": {
          "name": "JournalEntry",
          "description": "Postings that balance; the whole entry posts or nothing does",
          "provides": {
            "entry_posted": {
              "name": "EntryPosted",
              "description": "Money moved; balances and reports follow",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/ledger/schemas/entry_posted"
              }
            },
            "import_batch_postings": {
              "name": "ImportBatchPostings",
              "description": "Translate each line of Sovereign's batch file into an entry",
              "type": "operation",
              "internal": true,
              "raises": [
                {
                  "$ref": "#/boundedcontexts/ledger/aggregates/journal_entry/provides/entry_posted"
                }
              ]
            }
          },
          "consumes": [],
          "entities": {
            "journal_entry": {
              "name": "JournalEntry",
              "description": "One balanced movement of money",
              "root": true,
              "attributes": {
                "entry_id": {
                  "name": "entryId",
                  "type": "string",
                  "identity": true
                },
                "posted_at": {
                  "name": "postedAt",
                  "type": "date-time"
                },
                "reversal_of": {
                  "name": "reversalOf",
                  "type": "string",
                  "description": "The entry this one reverses, if any",
                  "optional": true
                },
                "value_date": {
                  "name": "valueDate",
                  "type": "ValueDate",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/ledger/valueobjects/value_date"
                  }
                }
              },
              "relations": [
                {
                  "target": {
                    "$ref": "#/boundedcontexts/ledger/aggregates/journal_entry/entities/posting"
                  },
                  "relation": "includes",
                  "label": "made-of",
                  "cardinality": "1..*"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/ledger/valueobjects/value_date"
                  },
                  "relation": "uses",
                  "label": "valued-on",
                  "cardinality": "1"
                }
              ]
            },
            "posting": {
              "name": "Posting",
              "description": "A debit or credit of an amount to one ledger account",
              "root": false,
              "attributes": {
                "posting_id": {
                  "name": "postingId",
                  "type": "string",
                  "identity": true
                },
                "ledger_account": {
                  "name": "ledgerAccount",
                  "type": "LedgerAccount",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/ledger/valueobjects/ledger_account"
                  }
                },
                "amount": {
                  "name": "amount",
                  "type": "Money",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/ledger/valueobjects/money"
                  }
                },
                "direction": {
                  "name": "direction",
                  "type": "PostingDirection",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/ledger/valueobjects/posting_direction"
                  }
                }
              },
              "relations": [
                {
                  "target": {
                    "$ref": "#/boundedcontexts/ledger/valueobjects/posting_direction"
                  },
                  "relation": "uses",
                  "label": "as",
                  "cardinality": "1"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/ledger/valueobjects/ledger_account"
                  },
                  "relation": "uses",
                  "label": "to",
                  "cardinality": "1"
                }
              ]
            }
          },
          "invariants": {
            "entry_balances": {
              "name": "EntryBalances",
              "description": "The debits of an entry equal its credits, or it does not post",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/ledger/aggregates/journal_entry/entities/posting"
                }
              ]
            },
            "at_least_two_postings": {
              "name": "AtLeastTwoPostings",
              "description": "An entry has at least two postings",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/ledger/aggregates/journal_entry/entities/journal_entry"
                }
              ]
            },
            "single_currency_per_entry": {
              "name": "SingleCurrencyPerEntry",
              "description": "Every posting in an entry shares one currency",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/ledger/aggregates/journal_entry/entities/posting/attributes/amount"
                }
              ]
            },
            "immutable_once_posted": {
              "name": "ImmutableOncePosted",
              "description": "A posted entry is never changed; it is reversed by another entry",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/ledger/aggregates/journal_entry/entities/journal_entry"
                }
              ]
            }
          }
        }
      },
      "invariants": {},
      "services": {
        "ledger_app": {
          "name": "LedgerApp",
          "description": "The ledger's application service: the documented posting API every other context uses",
          "type": "application",
          "provides": {
            "post_entry": {
              "name": "PostEntry",
              "description": "Post a balanced entry",
              "pattern": "open-host-service",
              "type": "operation",
              "schema": {
                "$ref": "#/boundedcontexts/ledger/schemas/post_entry"
              },
              "raises": [
                {
                  "$ref": "#/boundedcontexts/ledger/aggregates/journal_entry/provides/entry_posted"
                }
              ]
            },
            "reverse_entry": {
              "name": "ReverseEntry",
              "description": "Post the opposite entry against an earlier one",
              "pattern": "open-host-service",
              "type": "operation",
              "schema": {
                "$ref": "#/boundedcontexts/ledger/schemas/post_entry"
              },
              "raises": [
                {
                  "$ref": "#/boundedcontexts/ledger/aggregates/journal_entry/provides/entry_posted"
                }
              ]
            }
          },
          "consumes": [
            {
              "consumable": {
                "$ref": "#/boundedcontexts/sovereign_core_(legacy)/aggregates/savings_account_record/provides/nightly_batch_completed"
              },
              "pattern": "anti-corruption-layer"
            }
          ]
        }
      },
      "policies": {
        "import_nightly_batch": {
          "name": "Import nightly batch",
          "description": "Each line of the batch file becomes a ledger entry",
          "on": [
            {
              "$ref": "#/boundedcontexts/sovereign_core_(legacy)/aggregates/savings_account_record/provides/nightly_batch_completed"
            }
          ],
          "then": [
            {
              "$ref": "#/boundedcontexts/ledger/aggregates/journal_entry/provides/import_batch_postings"
            }
          ]
        }
      },
      "processes": {},
      "glossary": {
        "posting": {
          "name": "Posting",
          "definition": "One side of a movement: a debit or credit to one ledger account",
          "embodiedBy": {
            "$ref": "#/boundedcontexts/ledger/aggregates/journal_entry/entities/posting"
          }
        },
        "account": {
          "name": "Account",
          "definition": "A ledger account: a customer's account number or a nominal such as the loan book or scheme suspense. Not the Accounts platform's product, which is one kind of it",
          "aliases": [
            "Ledger account",
            "Nominal"
          ],
          "embodiedBy": {
            "$ref": "#/boundedcontexts/ledger/valueobjects/ledger_account"
          }
        },
        "posted_balance": {
          "name": "Posted balance",
          "definition": "The sum of postings to an account. What the ledger means by balance; Accounts subtracts holds from it to get the available one",
          "aliases": [
            "Balance"
          ],
          "embodiedBy": {
            "$ref": "#/boundedcontexts/ledger/aggregates/journal_entry/entities/posting"
          }
        },
        "entry": {
          "name": "Entry",
          "definition": "A balanced set of postings. Lending calls the disbursement one a drawdown",
          "aliases": [
            "Journal"
          ],
          "embodiedBy": {
            "$ref": "#/boundedcontexts/ledger/aggregates/journal_entry"
          }
        },
        "value_date": {
          "name": "Value date",
          "definition": "The date money counts from, which may differ from when it was posted",
          "embodiedBy": {
            "$ref": "#/boundedcontexts/ledger/valueobjects/value_date"
          }
        }
      },
      "valueobjects": {
        "money": {
          "name": "Money",
          "description": "Minor units and an ISO 4217 code. Never a float; @northbank/money is the one implementation. Co-owned by Accounts and Ledger through their shared kernel; declared in Ledger only because a value object has one home",
          "attributes": {
            "amount_minor": {
              "name": "amountMinor",
              "type": "int64"
            },
            "currency": {
              "name": "currency",
              "type": "ISO 4217 code"
            }
          },
          "relations": [],
          "invariants": {}
        },
        "account_number": {
          "name": "AccountNumber",
          "description": "Sort code and eight-digit number, from the same library as Money. Co-owned by Accounts and Ledger through their shared kernel; declared in Ledger only because a value object has one home",
          "attributes": {
            "sort_code": {
              "name": "sortCode",
              "type": "string"
            },
            "number": {
              "name": "number",
              "type": "string"
            }
          },
          "relations": [],
          "invariants": {}
        },
        "ledger_account": {
          "name": "LedgerAccount",
          "description": "Where a posting lands. No posting lands on a LedgerAccount as such: every one of them is a customer account or a nominal, and the two are named differently",
          "attributes": {},
          "relations": [],
          "invariants": {}
        },
        "customer_ledger_account": {
          "name": "CustomerLedgerAccount",
          "description": "A customer's account, named by its account number",
          "specialises": {
            "$ref": "#/boundedcontexts/ledger/valueobjects/ledger_account"
          },
          "attributes": {
            "account_number": {
              "name": "accountNumber",
              "type": "AccountNumber",
              "valueobject": {
                "$ref": "#/boundedcontexts/ledger/valueobjects/account_number"
              }
            }
          },
          "relations": [],
          "invariants": {}
        },
        "nominal_ledger_account": {
          "name": "NominalLedgerAccount",
          "description": "An account of the bank's own chart rather than a customer's: the loan book, scheme suspense, fee income",
          "specialises": {
            "$ref": "#/boundedcontexts/ledger/valueobjects/ledger_account"
          },
          "attributes": {
            "nominal_code": {
              "name": "nominalCode",
              "type": "string",
              "description": "From the chart of accounts, e.g. LOAN-BOOK, SCHEME-SUSPENSE"
            }
          },
          "relations": [],
          "invariants": {}
        },
        "posting_direction": {
          "name": "PostingDirection",
          "description": "debit or credit",
          "attributes": {
            "value": {
              "name": "value",
              "type": "'debit' | 'credit'"
            }
          },
          "relations": [],
          "invariants": {}
        },
        "value_date": {
          "name": "ValueDate",
          "description": "The date the money counts from, which may differ from the posting date",
          "attributes": {
            "value": {
              "name": "value",
              "type": "date"
            }
          },
          "relations": [],
          "invariants": {}
        }
      },
      "schemas": {
        "posting_line": {
          "name": "PostingLine",
          "description": "One side of a double entry, as a payload carries it",
          "attributes": {
            "ledger_account": {
              "name": "ledgerAccount",
              "type": "string"
            },
            "amount": {
              "name": "amount",
              "type": "Money"
            },
            "direction": {
              "name": "direction",
              "type": "'debit' | 'credit'"
            }
          }
        },
        "post_entry": {
          "name": "PostEntry",
          "description": "The postings a caller wants made, as one balanced entry",
          "attributes": {
            "postings": {
              "name": "postings",
              "type": "PostingLine[]",
              "schema": {
                "$ref": "#/boundedcontexts/ledger/schemas/posting_line"
              }
            },
            "value_date": {
              "name": "valueDate",
              "type": "ValueDate",
              "valueobject": {
                "$ref": "#/boundedcontexts/ledger/valueobjects/value_date"
              }
            }
          }
        },
        "entry_posted": {
          "name": "EntryPosted",
          "attributes": {
            "entry_id": {
              "name": "entryId",
              "type": "string",
              "identity": true
            },
            "postings": {
              "name": "postings",
              "type": "PostingLine[]",
              "schema": {
                "$ref": "#/boundedcontexts/ledger/schemas/posting_line"
              }
            }
          }
        }
      }
    },
    "sovereign_core_(legacy)": {
      "name": "Sovereign Core (legacy)",
      "description": "The 1989 COBOL core that still holds savings accounts and runs the nightly batch. Modelled at its edge only",
      "subdomains": [
        {
          "$ref": "#/domains/banking_products/subdomains/current_&_savings_accounts"
        }
      ],
      "bigBallOfMud": true,
      "team": {
        "$ref": "#/teams/core_banking_team"
      },
      "aggregates": {
        "savings_account_record": {
          "name": "SavingsAccountRecord",
          "description": "The mainframe's savings account row, as far as anyone can read it",
          "provides": {
            "nightly_batch_completed": {
              "name": "NightlyBatchCompleted",
              "description": "The day's savings movements are in the batch file",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/sovereign_core_(legacy)/schemas/nightly_batch_completed"
              }
            }
          },
          "consumes": [],
          "entities": {
            "savings_account_record": {
              "name": "SavingsAccountRecord",
              "description": "One savings account on Sovereign",
              "root": true,
              "attributes": {
                "account_no": {
                  "name": "accountNo",
                  "type": "string",
                  "identity": true
                },
                "product_code": {
                  "name": "productCode",
                  "type": "string"
                }
              },
              "relations": []
            }
          },
          "invariants": {}
        }
      },
      "invariants": {},
      "services": {},
      "policies": {},
      "processes": {},
      "glossary": {},
      "valueobjects": {},
      "schemas": {
        "nightly_batch_completed": {
          "name": "NightlyBatchCompleted",
          "description": "The batch file's header: date and the postings file location",
          "attributes": {
            "batch_date": {
              "name": "batchDate",
              "type": "date",
              "identity": true
            },
            "postings_file": {
              "name": "postingsFile",
              "type": "string"
            }
          }
        }
      }
    }
  },
  "relationships": [
    {
      "type": "upstream-downstream",
      "upstream": {
        "$ref": "#/boundedcontexts/sovereign_core_(legacy)"
      },
      "downstream": {
        "$ref": "#/boundedcontexts/ledger"
      },
      "upstreamRoles": [
        "published-language"
      ],
      "downstreamRoles": [
        "anti-corruption-layer"
      ],
      "description": "Every line of the batch file is translated"
    }
  ],
  "teams": {
    "core_banking_team": {
      "name": "Core Banking Team",
      "description": "The ledger, and Sovereign"
    }
  }
}