{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
        "AggregateSchema": {
            "additionalProperties": false,
            "description": "Represents an aggregate in the Open Domain Specification (ODS).",
            "properties": {
                "consumes": {
                    "items": {
                        "$ref": "#/definitions/ConsumptionSchema"
                    },
                    "type": "array"
                },
                "description": {
                    "type": "string"
                },
                "entities": {
                    "additionalProperties": {
                        "$ref": "#/definitions/EntitySchema"
                    },
                    "type": "object"
                },
                "invariants": {
                    "additionalProperties": {
                        "$ref": "#/definitions/InvariantSchema"
                    },
                    "type": "object"
                },
                "name": {
                    "type": "string"
                },
                "provides": {
                    "additionalProperties": {
                        "$ref": "#/definitions/ConsumableSchema"
                    },
                    "type": "object"
                }
            },
            "required": [
                "consumes",
                "description",
                "entities",
                "invariants",
                "name",
                "provides"
            ],
            "title": "Aggregate",
            "type": "object"
        },
        "AttributeSchema": {
            "additionalProperties": false,
            "description": "A named, typed property of an entity, value object or schema.",
            "properties": {
                "description": {
                    "type": "string"
                },
                "identifies": {
                    "additionalProperties": false,
                    "description": "The entity this attribute holds the identity of, when it is an identity\nof something else: `Order.petId` identifies Catalog's `Pet`. The target\nmay be in another bounded context — that is the point, since an identity\nis the only thing that crosses a boundary (decision 14) — and it may be\na child rather than a root, since a session holds the id of a profile\ninside a household; the child is reached through its own root.",
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                },
                "identity": {
                    "description": "True when this attribute is (part of) the identity of an entity.",
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "optional": {
                    "description": "True when the attribute is sometimes absent. Left off means required,\nwhich is the common case and stays unwritten (decision 24). An identity\nattribute is never optional.",
                    "type": "boolean"
                },
                "schema": {
                    "additionalProperties": false,
                    "description": "The schema that models this attribute's type, when the attribute is a\nshape of its own: the lines of an order, the address inside a customer.\nMutually exclusive with `valueobject`; a collection stays in the type\nstring (`OrderLine[]`).",
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                },
                "type": {
                    "description": "Free-form type name, e.g. `string`, `Money`, `Date`.",
                    "type": "string"
                },
                "valueobject": {
                    "additionalProperties": false,
                    "description": "The value object that models this attribute's type, when there is one.",
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                }
            },
            "required": [
                "name",
                "type"
            ],
            "title": "Attribute",
            "type": "object"
        },
        "BoundedContextSchema": {
            "additionalProperties": false,
            "description": "Represents a bounded context in the Open Domain Specification (ODS).",
            "properties": {
                "aggregates": {
                    "additionalProperties": {
                        "$ref": "#/definitions/AggregateSchema"
                    },
                    "type": "object"
                },
                "bigBallOfMud": {
                    "description": "Marks a context whose model is not coherent (typically legacy) so that\nneighbours know to protect themselves from it.",
                    "type": "boolean"
                },
                "description": {
                    "type": "string"
                },
                "external": {
                    "description": "Marks a system the enterprise does not own and does not model inside: a\ncard scheme, a payment provider, a licensor, a regulator, a clock. An\nexternal context provides and consumes consumables and takes part in\nrelationships, and it needs no subdomain, no team and no internals —\n`external-is-boundary` refuses aggregates, policies, processes and\ninvariants on it, because what happens inside it is not ours to state\n(decision 28).",
                    "type": "boolean"
                },
                "glossary": {
                    "additionalProperties": {
                        "$ref": "#/definitions/GlossaryTermSchema"
                    },
                    "type": "object"
                },
                "invariants": {
                    "additionalProperties": {
                        "$ref": "#/definitions/InvariantSchema"
                    },
                    "description": "The rules that hold across the instances or the aggregates of this\ncontext: uniqueness, quotas, limits, conservation. Each one names at\nleast one operation of the context that guards it, because a rule no\nsingle instance can see is kept true only by whoever checks it before\nacting (decision 27).",
                    "type": "object"
                },
                "name": {
                    "type": "string"
                },
                "policies": {
                    "additionalProperties": {
                        "$ref": "#/definitions/PolicySchema"
                    },
                    "type": "object"
                },
                "processes": {
                    "additionalProperties": {
                        "$ref": "#/definitions/ProcessSchema"
                    },
                    "description": "The processes this context runs: the reactions that hold state across\nevents, waiting for several of them before they act and knowing how they\nfinish. A policy that finds itself waiting for a second event is one of\nthese (decision 23).",
                    "type": "object"
                },
                "schemas": {
                    "additionalProperties": {
                        "$ref": "#/definitions/DataSchemaSchema"
                    },
                    "description": "Payload shapes this context publishes or accepts, referenced by its consumables.",
                    "type": "object"
                },
                "services": {
                    "additionalProperties": {
                        "$ref": "#/definitions/ServiceSchema"
                    },
                    "type": "object"
                },
                "subdomains": {
                    "description": "The subdomains this context serves; a context may serve several.",
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "$ref": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "$ref"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                "team": {
                    "additionalProperties": false,
                    "description": "The team that owns this context.",
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                },
                "valueobjects": {
                    "additionalProperties": {
                        "$ref": "#/definitions/ValueObjectSchema"
                    },
                    "description": "The values this context defines once: part of its ubiquitous language,\nreferenced by the attributes and relations of any of its aggregates.",
                    "type": "object"
                }
            },
            "required": [
                "aggregates",
                "description",
                "glossary",
                "invariants",
                "name",
                "policies",
                "processes",
                "schemas",
                "services",
                "subdomains",
                "valueobjects"
            ],
            "title": "BoundedContext",
            "type": "object"
        },
        "Comment": {
            "additionalProperties": false,
            "description": "A short grounded statement about the real system behind a strategic intent, optionally backed by one link.",
            "properties": {
                "link": {
                    "$ref": "#/definitions/CommentLink"
                },
                "text": {
                    "type": "string"
                }
            },
            "required": [
                "text"
            ],
            "title": "Comment",
            "type": "object"
        },
        "CommentLink": {
            "additionalProperties": false,
            "description": "Where the evidence for a comment lives: the code, the contract, the decision record, the runbook or the dashboard.",
            "properties": {
                "kind": {
                    "$ref": "#/definitions/CommentLinkKind"
                },
                "label": {
                    "description": "What to show instead of the raw URL.",
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            },
            "required": [
                "kind",
                "url"
            ],
            "title": "CommentLink",
            "type": "object"
        },
        "CommentLinkKind": {
            "description": "What a comment's link points at.",
            "enum": [
                "adr",
                "code",
                "contract",
                "dashboard",
                "runbook"
            ],
            "type": "string"
        },
        "ConsumableSchema": {
            "additionalProperties": false,
            "description": "Represents a consumable in the Open Domain Specification (ODS).",
            "properties": {
                "comments": {
                    "description": "Grounded statements about the real system behind this consumable.",
                    "items": {
                        "$ref": "#/definitions/Comment"
                    },
                    "type": "array"
                },
                "description": {
                    "type": "string"
                },
                "disposition": {
                    "$ref": "#/definitions/Disposition",
                    "description": "What the architecture thinks of this consumable. Absent means `by-design`."
                },
                "internal": {
                    "description": "True when the consumable stays inside its context: an event only local\npolicies react to, or an operation only local callers issue. Internal\nconsumables may not be consumed from another context.",
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "pattern": {
                    "$ref": "#/definitions/UpstreamRole",
                    "description": "The upstream role this consumable is offered under. Absent on internal consumables."
                },
                "raises": {
                    "description": "For operations: the event consumables this operation may raise.",
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "$ref": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "$ref"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                "rejects": {
                    "description": "For operations: the shapes the operation answers with when it refuses,\neach one of the context's schemas. A rejection is not an event, because\nnothing happened, and not a transport error, which stays outside the\nmodel. Absent means the operation either always succeeds or refuses\nwithout a domain-meaningful shape. Never valid on an event.",
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "$ref": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "$ref"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                "returns": {
                    "additionalProperties": false,
                    "description": "For operations: the payload shape the caller gets back, one of the\ncontext's schemas. Absent means the operation returns nothing worth\nnaming, which is honest for commands. Never valid on an event.",
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                },
                "schema": {
                    "additionalProperties": false,
                    "description": "The payload the caller sends, one of the context's schemas.",
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                },
                "type": {
                    "$ref": "#/definitions/ConsumableType"
                }
            },
            "required": [
                "description",
                "name",
                "type"
            ],
            "title": "Consumable",
            "type": "object"
        },
        "ConsumableType": {
            "enum": [
                "event",
                "operation"
            ],
            "type": "string"
        },
        "ConsumptionSchema": {
            "additionalProperties": false,
            "description": "Represents a consumption in the Open Domain Specification (ODS).",
            "properties": {
                "by": {
                    "description": "The consumer's own operations or policies that make this exchange, when\nonly some of them do: a subscription service consumes a payment gateway\nwhen it renews, not when it lists entitlements. Absent means the whole\nconsumer depends on the consumable, which is the common case. Optional\ndetail, not a call graph.",
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "$ref": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "$ref"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                "comments": {
                    "description": "Grounded statements about the real system behind this consumption.",
                    "items": {
                        "$ref": "#/definitions/Comment"
                    },
                    "type": "array"
                },
                "consumable": {
                    "additionalProperties": false,
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                },
                "disposition": {
                    "$ref": "#/definitions/Disposition",
                    "description": "What the architecture thinks of this consumption. Absent means `by-design`."
                },
                "pattern": {
                    "$ref": "#/definitions/DownstreamRole",
                    "description": "The downstream role the consumer adopts for this consumable."
                }
            },
            "required": [
                "consumable"
            ],
            "title": "Consumption",
            "type": "object"
        },
        "ContextRelationshipSchema": {
            "anyOf": [
                {
                    "$ref": "#/definitions/DirectedContextRelationshipSchema"
                },
                {
                    "$ref": "#/definitions/SymmetricContextRelationshipSchema"
                }
            ],
            "description": "A strategic relationship between two bounded contexts.",
            "title": "ContextRelationship"
        },
        "DataSchemaSchema": {
            "additionalProperties": false,
            "description": "A named payload shape owned by a bounded context, shared by the consumables that carry it.",
            "properties": {
                "attributes": {
                    "additionalProperties": {
                        "$ref": "#/definitions/AttributeSchema"
                    },
                    "type": "object"
                },
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            },
            "required": [
                "attributes",
                "name"
            ],
            "title": "DataSchema",
            "type": "object"
        },
        "DirectedContextRelationshipSchema": {
            "additionalProperties": false,
            "description": "An upstream/downstream relationship between two bounded contexts.",
            "properties": {
                "comments": {
                    "description": "Grounded statements about the real system behind this relationship.",
                    "items": {
                        "$ref": "#/definitions/Comment"
                    },
                    "type": "array"
                },
                "description": {
                    "type": "string"
                },
                "disposition": {
                    "$ref": "#/definitions/Disposition",
                    "description": "What the architecture thinks of this relationship. Absent means `by-design`."
                },
                "downstream": {
                    "additionalProperties": false,
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                },
                "downstreamRoles": {
                    "items": {
                        "$ref": "#/definitions/DownstreamRole"
                    },
                    "type": "array"
                },
                "type": {
                    "$ref": "#/definitions/DirectedRelationshipType"
                },
                "upstream": {
                    "additionalProperties": false,
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                },
                "upstreamRoles": {
                    "items": {
                        "$ref": "#/definitions/UpstreamRole"
                    },
                    "type": "array"
                }
            },
            "required": [
                "downstream",
                "downstreamRoles",
                "type",
                "upstream",
                "upstreamRoles"
            ],
            "title": "DirectedContextRelationship",
            "type": "object"
        },
        "DirectedRelationshipType": {
            "description": "Relationships with a clear upstream and downstream side. `customer-supplier`\nis an upstream/downstream relationship where the downstream team has a say\nin the upstream's planning.",
            "enum": [
                "customer-supplier",
                "upstream-downstream"
            ],
            "type": "string"
        },
        "Disposition": {
            "description": "What the architecture thinks of a strategic intent: `by-design` is how it\nshould be, `tolerated` a known compromise nobody plans to change, and\n`refactor` something that should be removed or replaced. An absent\ndisposition means `by-design`.",
            "enum": [
                "by-design",
                "refactor",
                "tolerated"
            ],
            "type": "string"
        },
        "DomainSchema": {
            "additionalProperties": false,
            "description": "Represents a domain in the Open Domain Specification (ODS).",
            "properties": {
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "subdomains": {
                    "additionalProperties": {
                        "$ref": "#/definitions/SubdomainSchema"
                    },
                    "type": "object"
                }
            },
            "required": [
                "description",
                "name",
                "subdomains"
            ],
            "title": "Domain",
            "type": "object"
        },
        "DownstreamRole": {
            "description": "How a downstream context protects itself from what it consumes.",
            "enum": [
                "anti-corruption-layer",
                "conformist"
            ],
            "type": "string"
        },
        "EntityRelationSchema": {
            "additionalProperties": false,
            "properties": {
                "cardinality": {
                    "$ref": "#/definitions/RelationCardinality"
                },
                "label": {
                    "type": "string"
                },
                "relation": {
                    "$ref": "#/definitions/EntityRelationType"
                },
                "target": {
                    "additionalProperties": false,
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                }
            },
            "required": [
                "relation",
                "target"
            ],
            "type": "object"
        },
        "EntityRelationType": {
            "enum": [
                "includes",
                "references",
                "uses"
            ],
            "type": "string"
        },
        "EntitySchema": {
            "additionalProperties": false,
            "description": "Represents an entity in the Open Domain Specification (ODS).",
            "properties": {
                "attributes": {
                    "additionalProperties": {
                        "$ref": "#/definitions/AttributeSchema"
                    },
                    "type": "object"
                },
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "relations": {
                    "items": {
                        "$ref": "#/definitions/EntityRelationSchema"
                    },
                    "type": "array"
                },
                "root": {
                    "type": "boolean"
                },
                "specialises": {
                    "additionalProperties": false,
                    "description": "The entity this one is a kind of: it has every attribute and relation of\nthat entity, plus its own. The target is an entity of the same\naggregate, and a subtype is never itself the root, because the aggregate\nhas one root and a kind of it is reached through it (decision 22).",
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                }
            },
            "required": [
                "attributes",
                "description",
                "name",
                "relations"
            ],
            "title": "Entity",
            "type": "object"
        },
        "GlossaryTermSchema": {
            "additionalProperties": false,
            "description": "A term of the ubiquitous language of a bounded context.",
            "properties": {
                "aliases": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "definition": {
                    "type": "string"
                },
                "embodiedBy": {
                    "additionalProperties": false,
                    "description": "The model element that embodies this term, when there is one.",
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                },
                "name": {
                    "type": "string"
                }
            },
            "required": [
                "definition",
                "name"
            ],
            "title": "GlossaryTerm",
            "type": "object"
        },
        "InvariantSchema": {
            "additionalProperties": false,
            "description": "A rule that holds inside an aggregate on every save, or across the instances and aggregates of a bounded context.",
            "properties": {
                "constrains": {
                    "description": "What this invariant is a rule about: the entities, value objects and\nattributes it holds over, and the operations it constrains, for a rule\nabout what an operation may do. An aggregate's invariant reaches inside\nits own aggregate and the value objects of its context; a context's\ninvariant reaches anywhere in the context and names at least one\noperation that guards it.",
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "$ref": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "$ref"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            },
            "required": [
                "constrains",
                "description",
                "name"
            ],
            "title": "Invariant",
            "type": "object"
        },
        "PolicySchema": {
            "additionalProperties": false,
            "description": "A reaction: when these events happen, issue these commands.",
            "properties": {
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "on": {
                    "description": "The event consumables that trigger this policy.",
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "$ref": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "$ref"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                "then": {
                    "description": "The operation consumables this policy issues.",
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "$ref": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "$ref"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                }
            },
            "required": [
                "description",
                "name",
                "on",
                "then"
            ],
            "title": "Policy",
            "type": "object"
        },
        "ProcessSchema": {
            "additionalProperties": false,
            "description": "A long-running reaction that holds state across events: it remembers which of its events have arrived and acts when enough of them have. What it correlates on, how long it waits and what it undoes are prose in its description rather than fields, because the model says that a process exists and what it listens to and does; how it decides is the code's (decisions 15 and 23).",
            "properties": {
                "comments": {
                    "description": "Grounded statements about the real system behind this process.",
                    "items": {
                        "$ref": "#/definitions/Comment"
                    },
                    "type": "array"
                },
                "description": {
                    "type": "string"
                },
                "disposition": {
                    "$ref": "#/definitions/Disposition",
                    "description": "What the architecture thinks of this process. Absent means `by-design`."
                },
                "ends": {
                    "description": "The event consumables that complete an instance.",
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "$ref": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "$ref"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                "name": {
                    "type": "string"
                },
                "on": {
                    "description": "Further event consumables the process waits for or reacts to while an\ninstance is alive. Like a policy's `on`, one of these may belong to\nanother context: subscribing to a published fact is how contexts\nintegrate (decision 23).",
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "$ref": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "$ref"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                "starts": {
                    "description": "The event consumables that begin an instance of this process.",
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "$ref": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "$ref"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                "then": {
                    "description": "The operation consumables of this process's own context that it issues.",
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "$ref": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "$ref"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                }
            },
            "required": [
                "description",
                "ends",
                "name",
                "on",
                "starts",
                "then"
            ],
            "title": "Process",
            "type": "object"
        },
        "RelationCardinality": {
