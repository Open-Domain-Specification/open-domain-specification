{
	"compilerOptions": {
		"target": "es2022",
		"module": "commonjs",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"outDir": "dist",
		"declaration": true,
		"emitDeclarationOnly": true,
		"sourceMap": true,
		"types": ["node"]
	},
	"include": ["src/index.ts", "src/site.ts"]
}
