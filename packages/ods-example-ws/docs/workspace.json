{
  "id": "swagger_petstore_(v3)",
  "name": "Swagger Petstore (v3)",
  "description": "DDD/ODS model for Swagger Petstore v3. Inventory is a projection returning a status→count map; Orders use placed|approved|delivered.",
  "version": "0.1.0",
  "odsVersion": "1.0.0",
  "primaryColor": "#0ea5e9",
  "domains": {
    "petstore_commerce": {
      "name": "Petstore Commerce",
      "description": "Core pet catalog, sales, and inventory capabilities",
      "subdomains": {
        "catalog": {
          "name": "Catalog",
          "type": "core",
          "description": "Pet definitions, attributes, lifecycle"
        },
        "sales": {
          "name": "Sales",
          "type": "core",
          "description": "Orders and order lifecycle"
        },
        "inventory": {
          "name": "Inventory",
          "type": "supporting",
          "description": "Aggregated availability by status"
        }
      }
    },
    "identity_&_accounts": {
      "name": "Identity & Accounts",
      "description": "Users and sessions per Petstore API",
      "subdomains": {
        "users": {
          "name": "Users",
          "type": "generic",
          "description": "User records and login/logout"
        }
      }
    }
  },
  "boundedcontexts": {
    "catalog_bc": {
      "name": "Catalog BC",
      "description": "Owns Pet aggregate & pet-facing operations",
      "subdomains": [
        {
          "$ref": "#/domains/petstore_commerce/subdomains/catalog"
        }
      ],
      "team": {
        "$ref": "#/teams/pet_shop_team"
      },
      "aggregates": {
        "pet": {
          "name": "Pet",
          "description": "A pet listed in the store",
          "provides": {
            "pet_registered": {
              "name": "PetRegistered",
              "description": "A new pet was registered",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/catalog_bc/schemas/pet_registered"
              }
            },
            "pet_updated": {
              "name": "PetUpdated",
              "description": "Pet profile updated",
              "pattern": "published-language",
              "type": "event"
            },
            "pet_status_changed": {
              "name": "PetStatusChanged",
              "description": "Pet status changed (available|pending|sold)",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/catalog_bc/schemas/pet_status_changed"
              }
            },
            "pet_photo_uploaded": {
              "name": "PetPhotoUploaded",
              "description": "Photo added via upload",
              "pattern": "published-language",
              "type": "event"
            },
            "pet_deleted": {
              "name": "PetDeleted",
              "description": "Pet removed from catalog",
              "pattern": "published-language",
              "type": "event"
            },
            "change_pet_status": {
              "name": "ChangePetStatus",
              "description": "Move a pet between available, pending and sold",
              "type": "operation",
              "internal": true,
              "schema": {
                "$ref": "#/boundedcontexts/catalog_bc/schemas/pet_status_changed"
              },
              "raises": [
                {
                  "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/provides/pet_status_changed"
                }
              ]
            }
          },
          "consumes": [],
          "entities": {
            "pet": {
              "name": "Pet",
              "description": "Pet root entity",
              "root": true,
              "attributes": {
                "id": {
                  "name": "id",
                  "type": "int64",
                  "identity": true
                },
                "name": {
                  "name": "name",
                  "type": "string"
                },
                "category": {
                  "name": "category",
                  "type": "Category",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/valueobjects/category"
                  }
                },
                "photo_urls": {
                  "name": "photoUrls",
                  "type": "PhotoUrl[]",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/valueobjects/photo_url"
                  }
                },
                "tags": {
                  "name": "tags",
                  "type": "Tag[]",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/valueobjects/tag"
                  }
                },
                "status": {
                  "name": "status",
                  "type": "PetStatus",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/valueobjects/pet_status"
                  }
                }
              },
              "relations": [
                {
                  "target": {
                    "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/valueobjects/category"
                  },
                  "relation": "uses",
                  "label": "categorized-as",
                  "cardinality": "0..1"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/valueobjects/tag"
                  },
                  "relation": "uses",
                  "label": "tagged-with",
                  "cardinality": "*"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/valueobjects/photo_url"
                  },
                  "relation": "uses",
                  "label": "has-photo",
                  "cardinality": "1..*"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/valueobjects/pet_status"
                  },
                  "relation": "uses",
                  "label": "has-status",
                  "cardinality": "1"
                }
              ]
            }
          },
          "valueobjects": {
            "category": {
              "name": "Category",
              "description": "The kind of animal, e.g. Dogs",
              "attributes": {
                "id": {
                  "name": "id",
                  "type": "int64"
                },
                "name": {
                  "name": "name",
                  "type": "string"
                }
              },
              "relations": []
            },
            "tag": {
              "name": "Tag",
              "description": "Free-form label on a pet",
              "attributes": {
                "id": {
                  "name": "id",
                  "type": "int64"
                },
                "name": {
                  "name": "name",
                  "type": "string"
                }
              },
              "relations": []
            },
            "photo_url": {
              "name": "PhotoUrl",
              "description": "Where a photo of the pet can be fetched",
              "attributes": {
                "url": {
                  "name": "url",
                  "type": "string (URL)"
                }
              },
              "relations": []
            },
            "pet_status": {
              "name": "PetStatus",
              "description": "Where the pet is in its sales lifecycle",
              "attributes": {
                "value": {
                  "name": "value",
                  "type": "'available' | 'pending' | 'sold'"
                }
              },
              "relations": []
            }
          },
          "invariants": {
            "name_required": {
              "name": "NameRequired",
              "description": "Pet.name must be non-empty",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/entities/pet/attributes/name"
                }
              ]
            },
            "sold_not_reopen": {
              "name": "SoldNotReopen",
              "description": "Once sold, do not revert to available without explicit policy",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/valueobjects/pet_status"
                }
              ]
            }
          }
        }
      },
      "services": {
        "pet_app": {
          "name": "PetApp",
          "description": "Open-host service for /pet endpoints",
          "type": "application",
          "provides": {
            "add_pet": {
              "name": "AddPet",
              "description": "POST /pet",
              "pattern": "open-host-service",
              "type": "operation",
              "schema": {
                "$ref": "#/boundedcontexts/catalog_bc/schemas/register_pet"
              },
              "raises": [
                {
                  "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/provides/pet_registered"
                }
              ]
            },
            "update_pet": {
              "name": "UpdatePet",
              "description": "PUT /pet",
              "pattern": "open-host-service",
              "type": "operation",
              "raises": [
                {
                  "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/provides/pet_updated"
                }
              ]
            },
            "find_pets_by_status": {
              "name": "FindPetsByStatus",
              "description": "GET /pet/findByStatus?status=available|pending|sold",
              "pattern": "open-host-service",
              "type": "operation"
            },
            "find_pets_by_tags": {
              "name": "FindPetsByTags",
              "description": "GET /pet/findByTags?tags=tag1,tag2",
              "pattern": "open-host-service",
              "type": "operation"
            },
            "get_pet_by_id": {
              "name": "GetPetById",
              "description": "GET /pet/{petId}",
              "pattern": "open-host-service",
              "type": "operation"
            },
            "upload_pet_image": {
              "name": "UploadPetImage",
              "description": "POST /pet/{petId}/uploadImage (multipart: additionalMetadata, file)",
              "pattern": "open-host-service",
              "type": "operation",
              "raises": [
                {
                  "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/provides/pet_photo_uploaded"
                }
              ]
            },
            "delete_pet": {
              "name": "DeletePet",
              "description": "DELETE /pet/{petId}",
              "pattern": "open-host-service",
              "type": "operation",
              "schema": {
                "$ref": "#/boundedcontexts/catalog_bc/schemas/pet_id"
              },
              "raises": [
                {
                  "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/provides/pet_deleted"
                }
              ]
            },
            "get_pet_summary": {
              "name": "GetPetSummary",
              "description": "Slim {id,name,status} read offered to other contexts for ACL checks",
              "pattern": "open-host-service",
              "type": "operation"
            }
          },
          "consumes": []
        }
      },
      "policies": {},
      "glossary": {
        "pet": {
          "name": "Pet",
          "definition": "An animal listed for sale in the store",
          "embodiedBy": {
            "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet"
          }
        },
        "category": {
          "name": "Category",
          "definition": "The kind of animal a pet is, such as Dogs or Cats",
          "aliases": [
            "Species"
          ],
          "embodiedBy": {
            "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/valueobjects/category"
          }
        },
        "available": {
          "name": "Available",
          "definition": "A pet that can be ordered; it becomes pending once an order is placed",
          "embodiedBy": {
            "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/valueobjects/pet_status"
          }
        }
      },
      "schemas": {
        "pet_registered": {
          "name": "PetRegistered",
          "description": "What the outside learns when a pet joins the catalog",
          "attributes": {
            "pet_id": {
              "name": "petId",
              "type": "int64",
              "identity": true
            },
            "name": {
              "name": "name",
              "type": "string"
            },
            "category": {
              "name": "category",
              "type": "Category",
              "valueobject": {
                "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/valueobjects/category"
              }
            },
            "status": {
              "name": "status",
              "type": "PetStatus",
              "valueobject": {
                "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/valueobjects/pet_status"
              }
            }
          }
        },
        "pet_status_changed": {
          "name": "PetStatusChanged",
          "attributes": {
            "pet_id": {
              "name": "petId",
              "type": "int64",
              "identity": true
            },
            "from": {
              "name": "from",
              "type": "PetStatus",
              "valueobject": {
                "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/valueobjects/pet_status"
              }
            },
            "to": {
              "name": "to",
              "type": "PetStatus",
              "valueobject": {
                "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/valueobjects/pet_status"
              }
            }
          }
        },
        "register_pet": {
          "name": "RegisterPet",
          "description": "Request body for adding a pet",
          "attributes": {
            "name": {
              "name": "name",
              "type": "string"
            },
            "category": {
              "name": "category",
              "type": "Category",
              "valueobject": {
                "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/valueobjects/category"
              }
            },
            "photo_urls": {
              "name": "photoUrls",
              "type": "PhotoUrl[]",
              "valueobject": {
                "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/valueobjects/photo_url"
              }
            }
          }
        },
        "pet_id": {
          "name": "PetId",
          "description": "Identifies one pet",
          "attributes": {
            "pet_id": {
              "name": "petId",
              "type": "int64",
              "identity": true
            }
          }
        }
      }
    },
    "sales_bc": {
      "name": "Sales BC",
      "description": "Owns Order aggregate & order-facing operations",
      "subdomains": [
        {
          "$ref": "#/domains/petstore_commerce/subdomains/sales"
        }
      ],
      "team": {
        "$ref": "#/teams/orders_team"
      },
      "aggregates": {
        "order": {
          "name": "Order",
          "description": "Order for a single pet",
          "provides": {
            "order_placed": {
              "name": "OrderPlaced",
              "description": "Order created (status=placed)",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/sales_bc/schemas/order_placed"
              }
            },
            "order_approved": {
              "name": "OrderApproved",
              "description": "Order approved (status=approved)",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/sales_bc/schemas/order_id"
              }
            },
            "order_delivered": {
              "name": "OrderDelivered",
              "description": "Order delivered (status=delivered)",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/sales_bc/schemas/order_id"
              }
            },
            "order_deleted": {
              "name": "OrderDeleted",
              "description": "Order deleted via DELETE /store/order/{orderId}",
              "pattern": "published-language",
              "type": "event",
              "schema": {
                "$ref": "#/boundedcontexts/sales_bc/schemas/order_id"
              }
            },
            "approve_order": {
              "name": "ApproveOrder",
              "description": "Approve a placed order once the pet is available",
              "type": "operation",
              "internal": true,
              "schema": {
                "$ref": "#/boundedcontexts/sales_bc/schemas/order_id"
              },
              "raises": [
                {
                  "$ref": "#/boundedcontexts/sales_bc/aggregates/order/provides/order_approved"
                }
              ]
            },
            "deliver_order": {
              "name": "DeliverOrder",
              "description": "Mark an approved order as delivered",
              "type": "operation",
              "internal": true,
              "schema": {
                "$ref": "#/boundedcontexts/sales_bc/schemas/order_id"
              },
              "raises": [
                {
                  "$ref": "#/boundedcontexts/sales_bc/aggregates/order/provides/order_delivered"
                }
              ]
            }
          },
          "consumes": [],
          "entities": {
            "order": {
              "name": "Order",
              "description": "Order root entity",
              "root": true,
              "attributes": {
                "id": {
                  "name": "id",
                  "type": "int64",
                  "identity": true
                },
                "pet_id": {
                  "name": "petId",
                  "type": "int64"
                },
                "quantity": {
                  "name": "quantity",
                  "type": "Quantity",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/sales_bc/aggregates/order/valueobjects/quantity"
                  }
                },
                "ship_date": {
                  "name": "shipDate",
                  "type": "ShipDate",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/sales_bc/aggregates/order/valueobjects/ship_date"
                  }
                },
                "status": {
                  "name": "status",
                  "type": "OrderStatus",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/sales_bc/aggregates/order/valueobjects/order_status"
                  }
                },
                "complete": {
                  "name": "complete",
                  "type": "CompleteFlag",
                  "valueobject": {
                    "$ref": "#/boundedcontexts/sales_bc/aggregates/order/valueobjects/complete_flag"
                  }
                }
              },
              "relations": [
                {
                  "target": {
                    "$ref": "#/boundedcontexts/sales_bc/aggregates/order/valueobjects/order_status"
                  },
                  "relation": "uses",
                  "label": "has-status",
                  "cardinality": "1"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/sales_bc/aggregates/order/valueobjects/quantity"
                  },
                  "relation": "uses",
                  "label": "has-quantity",
                  "cardinality": "1"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/sales_bc/aggregates/order/valueobjects/ship_date"
                  },
                  "relation": "uses",
                  "label": "ships-on",
                  "cardinality": "0..1"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/sales_bc/aggregates/order/valueobjects/complete_flag"
                  },
                  "relation": "uses",
                  "label": "is-complete",
                  "cardinality": "1"
                },
                {
                  "target": {
                    "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/entities/pet"
                  },
                  "relation": "references",
                  "label": "for-pet",
                  "cardinality": "1"
                }
              ]
            }
          },
          "valueobjects": {
            "order_status": {
              "name": "OrderStatus",
              "description": "Where the order is in its lifecycle",
              "attributes": {
                "value": {
                  "name": "value",
                  "type": "'placed' | 'approved' | 'delivered'"
                }
              },
              "relations": []
            },
            "quantity": {
              "name": "Quantity",
              "description": "How many of the pet are ordered",
              "attributes": {
                "value": {
                  "name": "value",
                  "type": "int > 0"
                }
              },
              "relations": []
            },
            "ship_date": {
              "name": "ShipDate",
              "description": "When the order ships",
              "attributes": {
                "value": {
                  "name": "value",
                  "type": "date-time"
                }
              },
              "relations": []
            },
            "complete_flag": {
              "name": "CompleteFlag",
              "description": "Whether the order is complete",
              "attributes": {
                "value": {
                  "name": "value",
                  "type": "boolean"
                }
              },
              "relations": []
            }
          },
          "invariants": {
            "quantity_positive": {
              "name": "QuantityPositive",
              "description": "Quantity must be > 0",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/sales_bc/aggregates/order/valueobjects/quantity"
                }
              ]
            },
            "approve_only_when_available": {
              "name": "ApproveOnlyWhenAvailable",
              "description": "Approve only if Pet.status == available",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/sales_bc/aggregates/order/valueobjects/order_status"
                },
                {
                  "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/valueobjects/pet_status"
                }
              ]
            },
            "deliver_only_when_approved": {
              "name": "DeliverOnlyWhenApproved",
              "description": "Deliver only from approved",
              "constrains": [
                {
                  "$ref": "#/boundedcontexts/sales_bc/aggregates/order/valueobjects/order_status"
                }
              ]
            }
          }
        }
      },
      "services": {
        "order_app": {
          "name": "OrderApp",
          "description": "Open-host service for /store/order endpoints",
          "type": "application",
          "provides": {
            "place_order": {
              "name": "PlaceOrder",
              "description": "POST /store/order",
              "pattern": "open-host-service",
              "type": "operation",
              "schema": {
                "$ref": "#/boundedcontexts/sales_bc/schemas/place_order"
              },
              "raises": [
                {
                  "$ref": "#/boundedcontexts/sales_bc/aggregates/order/provides/order_placed"
                }
              ]
            },
            "get_order_by_id": {
              "name": "GetOrderById",
              "description": "GET /store/order/{orderId}",
              "pattern": "open-host-service",
              "type": "operation"
            },
            "delete_order": {
              "name": "DeleteOrder",
              "description": "DELETE /store/order/{orderId}",
              "pattern": "open-host-service",
              "type": "operation",
              "raises": [
                {
                  "$ref": "#/boundedcontexts/sales_bc/aggregates/order/provides/order_deleted"
                }
              ]
            }
          },
          "consumes": [
            {
              "consumable": {
                "$ref": "#/boundedcontexts/catalog_bc/services/pet_app/provides/get_pet_summary"
              },
              "pattern": "anti-corruption-layer"
            }
          ]
        }
      },
      "policies": {
        "approve_when_pet_available": {
          "name": "Approve when pet available",
          "description": "When a pet becomes available and an order for it is placed, approve the order",
          "on": [
            {
              "$ref": "#/boundedcontexts/catalog_bc/aggregates/pet/provides/pet_status_changed"
            },
            {
              "$ref": "#/boundedcontexts/sales_bc/aggregates/order/provides/order_placed"
            }
          ],
          "then": [
            {
              "$ref": "#/boundedcontexts/sales_bc/aggregates/order/provides/approve_order"
            }
          ]
        }
      },
      "glossary": {
        "order": {
          "name": "Order",
          "definition": "A customer's request to buy one pet in a given quantity",
          "aliases": [
            "Purchase"
          ],
          "embodiedBy": {
            "$ref": "#/boundedcontexts/sales_bc/aggregates/order"
          }
        },
        "approval": {
          "name": "Approval",
          "definition": "Confirmation that the ordered pet is available and reserved",
          "embodiedBy": {
            "$ref": "#/boundedcontexts/sales_bc/aggregates/order/provides/approve_order"
          }
        }
      },
      "schemas": {
        "order_placed": {
          "name": "OrderPlaced",
          "attributes": {
            "order_id": {
              "name": "orderId",
              "type": "int64",
              "identity": true
            },
            "pet_id": {
              "name": "petId",
              "type": "int64"
            },
            "quantity": {
              "name": "quantity",
              "type": "Quantity",
              "valueobject": {
                "$ref": "#/boundedcontexts/sales_bc/aggregates/order/valueobjects/quantity"
              }
            }
          }
        },
        "place_order": {
          "name": "PlaceOrder",
          "description": "Request body for placing an order",
          "attributes": {
            "pet_id": {
              "name": "petId",
              "type": "int64"
            },
            "quantity": {
              "name": "quantity",
              "type": "Quantity",
              "valueobject": {
                "$ref": "#/boundedcontexts/sales_bc/aggregates/order/valueobjects/quantity"
              }
            }
          }
        },
        "order_id": {
          "name": "OrderId",
          "attributes": {
            "order_id": {
              "name": "orderId",
              "type": "int64",
              "identity": true
            }
          }
        }
      }
    },
    "inventory_bc": {
      "name": "Inventory BC",
      "description": "Projection for /store/inventory (status→count)",
      "subdomains": [
        {
          "$ref": "#/domains/petstore_commerce/subdomains/inventory"
        },
        {
          "$ref": "#/domains/petstore_commerce/subdomains/catalog"
        }
      ],
      "team": {
        "$ref": "#/teams/pet_shop_team"
      },
