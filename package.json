{
	"name": "open-domain-specification",
	"version": "0.0.0",
	"engines": {
		"node": ">=24"
	},
	"workspaces": [
		"apps/*",
		"packages/*",
		"models/*"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"release": "npm run build && lerna version --conventional-commits --yes && lerna publish from-package --yes",
		"clean": "lerna run clean --stream",
		"depcheck": "lerna run depcheck --stream",
		"format": "npx @biomejs/biome check --write",
		"build": "lerna run build --stream",
		"test": "lerna run build --stream && lerna run test --stream",
		"verify": "bash scripts/verify-all.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"lerna": "^8.2.3"
	}
}
