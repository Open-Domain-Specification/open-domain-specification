{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run ODS Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/apps/ods-vscode",
				"${workspaceFolder}/models/petstore"
			],
			"outFiles": ["${workspaceFolder}/apps/ods-vscode/dist/**/*.js"],
			"preLaunchTask": "ods-vscode: build"
		}
	]
}
