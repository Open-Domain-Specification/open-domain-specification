{
	"compilerOptions": {
		"target": "es2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"lib": ["es2022", "dom", "dom.iterable"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["."]
}
