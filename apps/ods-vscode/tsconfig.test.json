{
	"compilerOptions": {
		"target": "es2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"lib": ["es2022"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "out",
		"rootDir": "src",
		"sourceMap": true,
		"types": ["node", "mocha", "vscode"]
	},
	"include": ["src/test"]
}
