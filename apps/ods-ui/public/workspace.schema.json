{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "definitions": {
        "AggregateSchema": {
            "additionalProperties": false,
            "description": "Represents an aggregate in the Open Domain Specification (ODS).",
            "properties": {
                "consumes": {
                    "items": {
                        "$ref": "#/definitions/ConsumptionSchema"
                    },
                    "type": "array"
                },
                "description": {
                    "type": "string"
                },
                "entities": {
                    "additionalProperties": {
                        "$ref": "#/definitions/EntitySchema"
                    },
                    "type": "object"
                },
                "invariants": {
                    "additionalProperties": {
                        "$ref": "#/definitions/InvariantSchema"
                    },
                    "type": "object"
                },
                "name": {
                    "type": "string"
                },
                "provides": {
                    "additionalProperties": {
                        "$ref": "#/definitions/ConsumableSchema"
                    },
                    "type": "object"
                },
                "valueobjects": {
                    "additionalProperties": {
                        "$ref": "#/definitions/ValueObjectSchema"
                    },
                    "type": "object"
                }
            },
            "required": [
                "consumes",
                "description",
                "entities",
                "invariants",
                "name",
                "provides",
                "valueobjects"
            ],
            "title": "Aggregate",
            "type": "object"
        },
        "BoundedContextSchema": {
            "additionalProperties": false,
            "description": "Represents a bounded context in the Open Domain Specification (ODS).",
            "properties": {
                "aggregates": {
                    "additionalProperties": {
                        "$ref": "#/definitions/AggregateSchema"
                    },
                    "type": "object"
                },
                "bigBallOfMud": {
                    "description": "Marks a context whose model is not coherent (typically legacy) so that\nneighbours know to protect themselves from it.",
                    "type": "boolean"
                },
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "services": {
                    "additionalProperties": {
                        "$ref": "#/definitions/ServiceSchema"
                    },
                    "type": "object"
                },
                "subdomains": {
                    "description": "The subdomains this context serves; a context may serve several.",
                    "items": {
                        "additionalProperties": false,
                        "properties": {
                            "$ref": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "$ref"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                }
            },
            "required": [
                "aggregates",
                "description",
                "name",
                "services",
                "subdomains"
            ],
            "title": "BoundedContext",
            "type": "object"
        },
        "ConsumableSchema": {
            "additionalProperties": false,
            "description": "Represents a consumable in the Open Domain Specification (ODS).",
            "properties": {
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "pattern": {
                    "$ref": "#/definitions/UpstreamRole",
                    "description": "The upstream role this consumable is offered under."
                },
                "type": {
                    "$ref": "#/definitions/ConsumableType"
                }
            },
            "required": [
                "description",
                "name",
                "type"
            ],
            "title": "Consumable",
            "type": "object"
        },
        "ConsumableType": {
            "enum": [
                "event",
                "operation"
            ],
            "type": "string"
        },
        "ConsumptionSchema": {
            "additionalProperties": false,
            "description": "Represents a consumption in the Open Domain Specification (ODS).",
            "properties": {
                "consumable": {
                    "additionalProperties": false,
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                },
                "pattern": {
                    "$ref": "#/definitions/DownstreamRole",
                    "description": "The downstream role the consumer adopts for this consumable."
                }
            },
            "required": [
                "consumable"
            ],
            "title": "Consumption",
            "type": "object"
        },
        "ContextRelationshipSchema": {
            "anyOf": [
                {
                    "$ref": "#/definitions/DirectedContextRelationshipSchema"
                },
                {
                    "$ref": "#/definitions/SymmetricContextRelationshipSchema"
                }
            ],
            "description": "A strategic relationship between two bounded contexts.",
            "title": "ContextRelationship"
        },
        "DirectedContextRelationshipSchema": {
            "additionalProperties": false,
            "description": "An upstream/downstream relationship between two bounded contexts.",
            "properties": {
                "description": {
                    "type": "string"
                },
                "downstream": {
                    "additionalProperties": false,
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                },
                "downstreamRoles": {
                    "items": {
                        "$ref": "#/definitions/DownstreamRole"
                    },
                    "type": "array"
                },
                "type": {
                    "$ref": "#/definitions/DirectedRelationshipType"
                },
                "upstream": {
                    "additionalProperties": false,
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                },
                "upstreamRoles": {
                    "items": {
                        "$ref": "#/definitions/UpstreamRole"
                    },
                    "type": "array"
                }
            },
            "required": [
                "downstream",
                "downstreamRoles",
                "type",
                "upstream",
                "upstreamRoles"
            ],
            "title": "DirectedContextRelationship",
            "type": "object"
        },
        "DirectedRelationshipType": {
            "description": "Relationships with a clear upstream and downstream side. `customer-supplier`\nis an upstream/downstream relationship where the downstream team has a say\nin the upstream's planning.",
            "enum": [
                "customer-supplier",
                "upstream-downstream"
            ],
            "type": "string"
        },
        "DomainSchema": {
            "additionalProperties": false,
            "description": "Represents a domain in the Open Domain Specification (ODS).",
            "properties": {
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "subdomains": {
                    "additionalProperties": {
                        "$ref": "#/definitions/SubdomainSchema"
                    },
                    "type": "object"
                }
            },
            "required": [
                "description",
                "name",
                "subdomains"
            ],
            "title": "Domain",
            "type": "object"
        },
        "DownstreamRole": {
            "description": "How a downstream context protects itself from what it consumes.",
            "enum": [
                "anti-corruption-layer",
                "conformist"
            ],
            "type": "string"
        },
        "EntityRelationSchema": {
            "additionalProperties": false,
            "properties": {
                "label": {
                    "type": "string"
                },
                "relation": {
                    "$ref": "#/definitions/EntityRelationType"
                },
                "target": {
                    "additionalProperties": false,
                    "properties": {
                        "$ref": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "$ref"
                    ],
                    "type": "object"
                }
            },
            "required": [
                "relation",
                "target"
            ],
            "type": "object"
        },
        "EntityRelationType": {
            "enum": [
                "includes",
                "references",
                "uses"
            ],
            "type": "string"
        },
        "EntitySchema": {
            "additionalProperties": false,
            "description": "Represents an entity in the Open Domain Specification (ODS).",
            "properties": {
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "relations": {
                    "items": {
                        "$ref": "#/definitions/EntityRelationSchema"
                    },
                    "type": "array"
                },
                "root": {
                    "type": "boolean"
                }
            },
            "required": [
                "description",
                "name",
                "relations"
            ],
            "title": "Entity",
            "type": "object"
        },
        "InvariantSchema": {
            "additionalProperties": false,
            "description": "Represents an invariant in the Open Domain Specification (ODS).",
            "properties": {
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            },
            "required": [
                "description",
                "name"
            ],
            "title": "Invariant",
            "type": "object"
        },
        "ServiceSchema": {
            "additionalProperties": false,
            "description": "Represents a service in the Open Domain Specification (ODS).",
            "properties": {
                "consumes": {
                    "items": {
                        "$ref": "#/definitions/ConsumptionSchema"
                    },
                    "type": "array"
                },
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "provides": {
                    "additionalProperties": {
                        "$ref": "#/definitions/ConsumableSchema"
                    },
                    "type": "object"
                },
                "type": {
                    "$ref": "#/definitions/ServiceType"
                }
            },
            "required": [
                "consumes",
                "description",
                "name",
                "provides",
                "type"
            ],
            "title": "Service",
            "type": "object"
        },
        "ServiceType": {
            "enum": [
                "application",
                "domain",
                "infrastructure"
            ],
            "type": "string"
        },
        "SubdomainSchema": {
            "additionalProperties": false,
            "description": "Represents a subdomain in the Open Domain Specification (ODS).",
            "properties": {
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "type": {
                    "$ref": "#/definitions/SubdomainType"
                }
            },
            "required": [
                "description",
                "name",
                "type"
            ],
            "title": "Subdomain",
            "type": "object"
        },
        "SubdomainType": {
            "description": "Strategic classification of a subdomain: the part of the problem space\nthe business competes on (core), needs but does not differentiate on\n(supporting), or can buy off the shelf (generic).",
            "enum": [
                "core",
                "generic",
                "supporting"
            ],
            "type": "string"
        },
        "SymmetricContextRelationshipSchema": {
            "additionalProperties": false,
            "description": "A relationship between two bounded contexts with no upstream or downstream side.",
            "properties": {
                "description": {
                    "type": "string"
                },
                "participants": {
                    "items": [
                        {
                            "additionalProperties": false,
                            "properties": {
                                "$ref": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "$ref"
                            ],
                            "type": "object"
                        },
                        {
                            "additionalProperties": false,
                            "properties": {
                                "$ref": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "$ref"
                            ],
                            "type": "object"
                        }
                    ],
                    "maxItems": 2,
                    "minItems": 2,
                    "type": "array"
                },
                "type": {
                    "$ref": "#/definitions/SymmetricRelationshipType"
                }
            },
            "required": [
                "participants",
                "type"
            ],
            "title": "SymmetricContextRelationship",
            "type": "object"
        },
        "SymmetricRelationshipType": {
            "description": "Relationships without a direction: teams share a kernel, work as partners,\nor deliberately do not integrate at all.",
            "enum": [
                "partnership",
                "separate-ways",
                "shared-kernel"
            ],
            "type": "string"
        },
        "UpstreamRole": {
            "description": "How an upstream context exposes what it provides.",
            "enum": [
                "open-host-service",
                "published-language"
            ],
            "type": "string"
        },
        "ValueObjectSchema": {
            "additionalProperties": false,
            "description": "Represents a value object in the Open Domain Specification (ODS).",
            "properties": {
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "relations": {
                    "items": {
                        "$ref": "#/definitions/EntityRelationSchema"
                    },
                    "type": "array"
                }
            },
            "required": [
                "description",
                "name",
                "relations"
            ],
            "title": "ValueObject",
            "type": "object"
        }
    },
    "description": "Represents a workspace in the Open Domain Specification (ODS).",
    "properties": {
        "boundedcontexts": {
            "additionalProperties": {
                "$ref": "#/definitions/BoundedContextSchema"
            },
            "type": "object"
        },
        "description": {
            "type": "string"
        },
        "domains": {
            "additionalProperties": {
                "$ref": "#/definitions/DomainSchema"
            },
            "type": "object"
        },
        "homepage": {
            "type": "string"
        },
        "id": {
            "type": "string"
        },
        "logoUrl": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "odsVersion": {
            "pattern": "^[0-9]*\\.[0-9]*\\.[0-9]*$",
            "type": "string"
        },
        "primaryColor": {
            "type": "string"
        },
        "relationships": {
            "items": {
                "$ref": "#/definitions/ContextRelationshipSchema"
            },
            "type": "array"
        },
        "version": {
            "type": "string"
        }
    },
    "required": [
        "boundedcontexts",
        "description",
        "domains",
        "id",
        "name",
        "odsVersion",
        "relationships",
        "version"
    ],
    "title": "Workspace",
    "type": "object"
}

